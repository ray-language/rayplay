// 16-bit PCM in memory (`Pcm`, and the `Sink` it is collected in: tests and tools), `Raw`,
// uncompressed PCM left where it is in a loaded file and read as 24 bits for the player, and a
// RIFF/WAVE reader and writer. WAVs of 16 or 24 bits are read; everything is little-endian;
// `b[i]` is the octet at `i`.

import pcm24;

/// Interleaved s16le samples with their format.
pub struct Pcm {
    rate: int,
    channels: int,
    data: bytes,
}

pub fn frames(p: Pcm) -> int {
    p.data.len() / (2 * p.channels)
}

pub fn duration_ms(p: Pcm) -> int {
    if (p.rate == 0) { 0 } else { frames(p) * 1000 / p.rate }
}

/// Collects s16le samples for a decoder: they go through `[int]` and are flushed to `bytes`
/// every 768 KB, so a long track costs little more than its own size.
pub struct Sink {
    done: bytes,
    octets: [int],
}

pub fn sink() -> Sink {
    Sink { done: bytes_of([]), octets: [] }
}

/// Appends one sample, clamped to 16 bits.
pub fn put(s: Sink, v: int) -> unit {
    let c = if (v > 32767) { 32767 } else if (v < -32768) { -32768 } else { v };
    let u = if (c < 0) { c + 65536 } else { c };
    s.octets.push(u & 255);
    s.octets.push(u >> 8);
    if (s.octets.len() >= 786432) {
        s.done = s.done + bytes_of(s.octets);
        s.octets = [];
    }
}

/// A 24-bit sample rounded to 16 bits (`put` clamps the top).
pub fn round_16(v: int) -> int {
    (v + 128) >> 8
}

pub fn finish(s: Sink) -> bytes {
    s.done = s.done + bytes_of(s.octets);
    s.octets = [];
    s.done
}

/// Integer PCM still inside the file it came in (a WAV or an AIFF): where the samples start and
/// how they are stored. Nothing is converted on load; `sample` reads any one of them as 24 bits.
pub struct Raw {
    b: bytes,
    /// The octet the first sample starts at.
    from: int,
    /// Whole frames (samples per channel).
    frames: int,
    rate: int,
    channels: int,
    /// Bits per sample: 8, 16, 24 or 32.
    depth: int,
    /// Byte order of each sample.
    big_endian: bool,
}

/// Sample `i` (interleaved) as a signed 24-bit value: shallower samples (8-bit ones are signed,
/// as in AIFF) are scaled up and 32-bit ones rounded.
pub fn sample(r: Raw, i: int) -> int {
    let step = r.depth / 8;
    let at = r.from + i * step;
    let b = r.b;
    if (step <= 2) {
        var v = 0;
        if (r.big_endian) {
            v = if (step == 1) { b[at] << 8 } else { (b[at] << 8) | b[at + 1] };
        } else {
            v = (b[at + 1] << 8) | b[at];
        }
        return if (v >= 32768) { v - 65536 } else { v } << 8;
    }
    var v = 0;
    for k in 0..step {
        v = (v << 8) | if (r.big_endian) { b[at + k] } else { b[at + step - 1 - k] };
    }
    let top = 1 << (r.depth - 1);
    pcm24.of(if (v >= top) { v - 2 * top } else { v }, r.depth)
}

/// The whole of `r` as s16le (tests, tools), deeper samples rounded: a 16-bit little-endian WAV
/// is shared, not copied.
pub fn to_pcm(r: Raw) -> Pcm {
    let n = r.frames * r.channels;
    if (r.depth == 16 && !r.big_endian) {
        return Pcm {
            rate: r.rate,
            channels: r.channels,
            data: r.b.sub_bytes(r.from, r.from + 2 * n)
        };
    }
    let s = sink();
    for i in 0..n {
        put(s, round_16(sample(r, i)));
    }
    Pcm { rate: r.rate, channels: r.channels, data: finish(s) }
}

fn read_u16(b: bytes, at: int) -> int {
    b[at] + b[at + 1] * 256
}

fn read_u32(b: bytes, at: int) -> int {
    b[at] + b[at + 1] * 256 + b[at + 2] * 65536 + b[at + 3] * 16777216
}

fn tag(b: bytes, at: int) -> string {
    from_utf8(b.sub_bytes(at, at + 4)).unwrap_or("")
}

/// Opens a WAV file: PCM (format 1) or WAVE_FORMAT_EXTENSIBLE (0xFFFE) with 16- or 24-bit
/// samples. Only the header is read.
pub fn open(b: bytes) -> Result<Raw, string> {
    if (b.len() < 12 || tag(b, 0) != "RIFF" || tag(b, 8) != "WAVE") {
        return Result.Err("not a WAV file");
    }
    var rate = 0;
    var channels = 0;
    var bits = 0;
    var format = 0;
    var at = 12;
    while (at + 8 <= b.len()) {
        let id = tag(b, at);
        let size = read_u32(b, at + 4);
        let body = at + 8;
        if (id == "fmt " && body + 16 <= b.len()) {
            format = read_u16(b, body);
            channels = read_u16(b, body + 2);
            rate = read_u32(b, body + 4);
            bits = read_u16(b, body + 14);
        } else if (id == "data") {
            if (format != 1 && format != 65534) {
                return Result.Err("unsupported WAV format ${to_string(format)} (only PCM)");
            }
            if (bits != 16 && bits != 24) {
                return Result.Err(
                    "unsupported WAV: ${to_string(bits)}-bit samples (only 16- or 24-bit)"
                );
            }
            if (channels < 1 || channels > 2 || rate < 8000 || rate > 192000) {
                return Result.Err(
                    "unsupported WAV: ${to_string(channels)} channels at ${to_string(rate)} Hz"
                );
            }
            let end = if (body + size <= b.len()) { body + size } else { b.len() };
            let frame = bits / 8 * channels;
            return Result.Ok(
                Raw {
                    b: b,
                    from: body,
                    frames: (end - body) / frame,
                    rate: rate,
                    channels: channels,
                    depth: bits,
                    big_endian: false
                }
            );
        }
        // Chunks are word-aligned: an odd size carries one pad byte.
        at = body + size + size % 2;
    }
    Result.Err("WAV without a data chunk")
}

/// Parses a WAV file into 16-bit PCM (24-bit samples dithered).
pub fn parse(b: bytes) -> Result<Pcm, string> {
    Result.Ok(to_pcm(open(b)?))
}

fn le16(v: int) -> [int] {
    [v % 256, v / 256 % 256]
}

fn le32(v: int) -> [int] {
    [v % 256, v / 256 % 256, v / 65536 % 256, v / 16777216 % 256]
}

/// Encodes PCM as a canonical 44-byte-header WAV (tests, and the export of a loaded track).
pub fn encode(p: Pcm) -> bytes {
    let block = 2 * p.channels;
    var head: [int] = [];
    head = head + [82, 73, 70, 70] + le32(36 + p.data.len()) + [87, 65, 86, 69];
    head = head + [102, 109, 116, 32] + le32(16) + le16(1) + le16(p.channels);
    head = head + le32(p.rate) + le32(p.rate * block) + le16(block) + le16(16);
    head = head + [100, 97, 116, 97] + le32(p.data.len());
    var out = head;
    for i in 0..p.data.len() {
        out.push(p.data[i]);
    }
    bytes_of(out)
}
