// An AIFF and AIFF-C reader: Apple's counterpart of WAV, with big-endian integer PCM in IFF
// chunks (`FORM` … `AIFF`/`AIFC`, then `COMM` and `SSND`). Samples of 8, 16, 24 or 32 bits,
// mono or stereo; AIFF-C only uncompressed (`NONE`, `twos`) or little-endian 16-bit (`sowt`).
// `open` only reads the header and leaves the samples in the file (`wav.Raw`), converted to
// 16 bits a chunk at a time as they play: deeper samples truncated, 8-bit ones scaled up.

import wav;

fn read_u16(b: bytes, at: int) -> int {
    (b[at] << 8) | b[at + 1]
}

fn read_u32(b: bytes, at: int) -> int {
    (b[at] << 24) | (b[at + 1] << 16) | (b[at + 2] << 8) | b[at + 3]
}

fn tag(b: bytes, at: int) -> string {
    from_utf8(b.sub_bytes(at, at + 4)).unwrap_or("")
}

/// The sample rate, stored as an 80-bit IEEE extended float: a 15-bit exponent and a 64-bit
/// mantissa with an explicit integer bit. The top 32 bits of the mantissa are enough for any
/// rate below 2^31.
fn extended_rate(b: bytes, at: int) -> int {
    let e = (read_u16(b, at) & 0x7FFF) - 16383;
    let hi = read_u32(b, at + 2);
    if (e < 0 || e > 31) { 0 } else { hi >> (31 - e) }
}

/// Opens an AIFF or AIFF-C file. Only the header is read.
pub fn open(b: bytes) -> Result<wav.Raw, string> {
    if (b.len() < 12 || tag(b, 0) != "FORM") {
        return Result.Err("not an AIFF file");
    }
    let kind = tag(b, 8);
    if (kind != "AIFF" && kind != "AIFC") {
        return Result.Err("not an AIFF file");
    }
    var channels = 0;
    var depth = 0;
    var rate = 0;
    var compression = "NONE";
    var data_from = -1;
    var data_to = -1;
    var at = 12;
    while (at + 8 <= b.len()) {
        let id = tag(b, at);
        let size = read_u32(b, at + 4);
        let body = at + 8;
        let end = if (body + size <= b.len()) { body + size } else { b.len() };
        if (id == "COMM" && body + 18 <= b.len()) {
            channels = read_u16(b, body);
            depth = read_u16(b, body + 6);
            rate = extended_rate(b, body + 8);
            if (kind == "AIFC" && body + 22 <= b.len()) {
                compression = tag(b, body + 18);
            }
        } else if (id == "SSND" && body + 8 <= b.len()) {
            data_from = body + 8 + read_u32(b, body);
            data_to = end;
        }
        // Chunks are word-aligned: an odd size carries one pad byte.
        at = body + size + size % 2;
    }
    if (channels == 0) {
        return Result.Err("AIFF without a COMM chunk");
    }
    if (data_from < 0) {
        return Result.Err("AIFF without a SSND chunk");
    }
    let swap = compression == "sowt";
    if (compression != "NONE" && compression != "twos" && !swap) {
        return Result.Err(
            "unsupported AIFF-C compression '${compression}' (only uncompressed PCM)"
        );
    }
    if ((depth != 8 && depth != 16 && depth != 24 && depth != 32) || (swap && depth != 16)) {
        return Result.Err("unsupported AIFF: ${to_string(depth)}-bit samples");
    }
    if (channels > 2 || rate < 8000 || rate > 192000) {
        return Result.Err(
            "unsupported AIFF: ${to_string(channels)} channels at ${to_string(rate)} Hz"
        );
    }
    let frame = depth / 8 * channels;
    let from = if (data_from < data_to) { data_from } else { data_to };
    Result.Ok(
        wav.Raw {
            b: b,
            from: from,
            frames: (data_to - from) / frame,
            rate: rate,
            channels: channels,
            depth: depth,
            big_endian: !swap
        }
    )
}

/// Parses an AIFF or AIFF-C file into 16-bit PCM.
pub fn parse(b: bytes) -> Result<wav.Pcm, string> {
    Result.Ok(wav.to_pcm(open(b)?))
}
