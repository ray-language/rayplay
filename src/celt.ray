const VERY_SMALL: float = 1e-30;

const PREEMPH: float = 0.8500061;

/// Width of a row of the PVQ codeword counts.
const PVQ_W: int = 180;

const TRIM_ICDF: [int] = [126, 124, 119, 109, 87, 41, 19, 9, 4, 2, 0];

const SPREAD_ICDF: [int] = [25, 23, 2, 0];

