// The player: ONE fiber owns the audio output and the playlist, and everything else talks
// to it through a channel of commands (the actor pattern — fibers do not share a heap).
// Sound is written to std/audio in 50 ms chunks; `write` parks the fiber while the device
// is full, so the device sets the pace and commands are picked up between chunks.
//
// Position keeping: `audio.played_ms` counts from when the device was opened, and `base_ms`
// is what to add to it to get the position in the track. Closing the device does not cut what
// is queued (on iOS, a quarter of a second or more): it would sound on under the next output.
// So a seek, or a change of track into the same rate and channels, keeps the device and goes on
// writing; and a device is closed only once its queue has played (a pause, a stop, a track in
// another format).

import std/audio;
import std/math;
import std/time;
import synth;

pub enum Cmd {
    Play(int),
    Toggle,
    Stop,
    Next,
    Prev,
    Seek(int),
    Volume(int),
    Add(synth.Track),
    Note(string),
    Query(Channel<Snapshot>),
    Quit,
}

/// What the page shows: the playlist and where playback is.
pub struct Snapshot {
    tracks: [(string, int)],
    current: int,
    playing: bool,
    paused: bool,
    position_ms: int,
    volume: int,
    /// The last lifecycle note ("background 12:01:03") and how much sounded since it.
    note: string,
    background_ms: int,
    error: string,
}

const CHUNK_MS: int = 50;

const LATENCY_MS: int = 120;

/// The fades around a seek: short enough not to be heard as a gap, long enough not to click.
const FADE_MS: int = 10;

struct State {
    tracks: [synth.Track],
    current: int,
    playing: bool,
    paused: bool,
    volume: int,
    /// The volume the last chunk ended at: the next one ramps from it to `volume`.
    volume_prev: int,
    handle: int,
    base_ms: int,
    frame: int,
    /// Frames written since the device was opened.
    written: int,
    note: string,
    in_background: bool,
    background_ms: int,
    error: string,
}

fn position_ms(s: State) -> int {
    if (s.playing && !s.paused && s.handle != 0) {
        // Right after a seek, until what was queued has played, this is a little short of it.
        let at = s.base_ms + audio.played_ms(s.handle).unwrap_or(0);
        if (at < 0) { 0 } else { at }
    } else {
        s.base_ms
    }
}

fn snapshot(s: State) -> Snapshot {
    var tracks: [(string, int)] = [];
    for t in s.tracks {
        tracks.push((t.name, t.duration_ms));
    }
    Snapshot {
        tracks: tracks,
        current: s.current,
        playing: s.playing,
        paused: s.paused,
        position_ms: position_ms(s),
        volume: s.volume,
        note: s.note,
        background_ms: s.background_ms,
        error: s.error
    }
}

/// Ends the output: what is playing fades out, and the queue plays before the device closes.
fn close_output(s: State) -> unit {
    if (s.handle != 0) {
        if (s.playing && !s.paused) {
            fade_out(s);
        }
        let _d = audio.drain(s.handle);
        close(s.handle);
        s.handle = 0;
    }
}

/// Writes the next few milliseconds of the current track fading to silence (nothing past its end).
fn fade_out(s: State) -> unit {
    let t = s.tracks[s.current];
    let left = synth.total_frames(t) - s.frame;
    let frames = math.min(t.rate * FADE_MS / 1000, left);
    if (frames > 0) {
        write_counted(s, synth.chunk_ramp(t, s.frame, frames, s.volume_prev, 0), frames);
        s.frame = s.frame + frames;
    }
    s.volume_prev = 0;
}

/// Opens the device for the current track at `ms` into it.
fn open_at(s: State, ms: int) -> unit {
    let t = s.tracks[s.current];
    match (audio.open_latency(t.rate, t.channels, LATENCY_MS)) {
        Result.Ok(h) => {
            s.handle = h;
            s.error = "";
        },
        Result.Err(e) => {
            s.error = "audio: " + e;
            s.playing = false;
            s.paused = false;
            eprint("rayplay: " + s.error);
        },
    }
    s.base_ms = ms;
    s.frame = ms * t.rate / 1000;
    s.written = 0;
    // The first chunk fades in from silence.
    s.volume_prev = 0;
}

/// Goes on at `ms` into the current track in the same output, after what is queued.
fn continue_at(s: State, ms: int) -> unit {
    let t = s.tracks[s.current];
    // The new position starts sounding once everything written so far has played.
    s.base_ms = ms - s.written * 1000 / t.rate;
    s.frame = ms * t.rate / 1000;
}

/// Moves playback to `ms` without reopening the device: the old position fades out and the
/// new one fades in, each in a few milliseconds, after what is still queued.
fn seek_playing(s: State, ms: int) -> unit {
    fade_out(s);
    continue_at(s, ms);
    fade_in(s);
}

/// Writes the next few milliseconds of the current track rising from silence.
fn fade_in(s: State) -> unit {
    let t = s.tracks[s.current];
    let frames = t.rate * FADE_MS / 1000;
    write_counted(s, synth.chunk_ramp(t, s.frame, frames, 0, s.volume), frames);
    s.frame = s.frame + frames;
    s.volume_prev = s.volume;
}

/// Writes `data` (`frames` frames); a failed write is left for `feed` to report.
fn write_counted(s: State, data: bytes, frames: int) -> unit {
    if let Result.Ok(_) = audio.write(s.handle, data) {
        s.written = s.written + frames;
    }
}

/// Plays track `index` from `ms`. While playing into an output of the same rate and channels,
/// the output goes on: a track that ended runs into the next without a gap, and one that is
/// cut fades out first. Otherwise the output is closed (once its queue has played) and a new
/// one opened.
fn start(s: State, index: int, ms: int) -> unit {
    if (s.tracks.len() == 0) {
        return;
    }
    let i = (index % s.tracks.len() + s.tracks.len()) % s.tracks.len();
    let from = s.tracks[s.current];
    let to = s.tracks[i];
    if (s.playing
        && !s.paused
        && s.handle != 0
        && from.rate == to.rate
        && from.channels == to.channels) {
        let ended = s.frame >= synth.total_frames(from);
        if (!ended) {
            fade_out(s);
        }
        s.current = i;
        continue_at(s, ms);
        if (!ended || ms > 0) {
            fade_in(s);
        }
        return;
    }
    close_output(s);
    s.current = i;
    s.playing = true;
    s.paused = false;
    open_at(s, ms);
}

fn stop(s: State) -> unit {
    close_output(s);
    s.playing = false;
    s.paused = false;
    s.base_ms = 0;
    s.frame = 0;
}

/// Pauses where the sound stops: after a short fade and the queue, which still plays.
fn pause(s: State) -> unit {
    fade_out(s);
    s.paused = true;
    close_output(s);
    s.base_ms = s.frame * 1000 / s.tracks[s.current].rate;
}

fn handle(s: State, cmd: Cmd) -> bool {
    match (cmd) {
        Cmd.Play(i) => start(s, i, 0),
        Cmd.Toggle => {
            if (!s.playing) {
                start(s, s.current, 0);
            } else if (s.paused) {
                start(s, s.current, s.base_ms);
            } else {
                pause(s);
            }
        },
        Cmd.Stop => stop(s),
        Cmd.Next => step(s, 1),
        Cmd.Prev => step(s, s.tracks.len() - 1),
        Cmd.Seek(ms) => {
            let t = s.tracks[s.current];
            let clamped = if (ms < 0) {
                0
            } else if (ms > t.duration_ms) {
                t.duration_ms
            } else {
                ms
            };
            if (s.playing && !s.paused && s.handle != 0) {
                seek_playing(s, clamped);
            } else if (s.playing && !s.paused) {
                start(s, s.current, clamped);
            } else {
                s.base_ms = clamped;
                s.frame = clamped * t.rate / 1000;
            }
        },
        Cmd.Volume(v) => {
            s.volume = if (v < 0) { 0 } else if (v > 100) { 100 } else { v };
        },
        Cmd.Add(t) => {
            s.tracks.push(t);
        },
        Cmd.Note(n) => {
            s.note = n;
            s.in_background = n.starts_with("background");
            if (s.in_background) {
                s.background_ms = 0;
            }
        },
        Cmd.Query(reply) => send(reply, snapshot(s)),
        Cmd.Quit => {
            stop(s);
            return false;
        },
    }
    true
}

/// Moves `by` tracks along the playlist: playing it if a track was playing or paused.
fn step(s: State, by: int) -> unit {
    if (s.tracks.len() == 0) {
        return;
    }
    let next = (s.current + by) % s.tracks.len();
    if (s.playing) {
        start(s, next, 0);
    } else {
        stop(s);
        s.current = next;
    }
}

/// Writes the next chunk of the current track; at the end, moves to the next track.
fn feed(s: State) -> unit {
    let t = s.tracks[s.current];
    let total = synth.total_frames(t);
    if (s.frame >= total) {
        start(s, s.current + 1, 0);
        return;
    }
    // The last chunk stops at the end of the track, so the next one follows without a gap.
    let frames = math.min(t.rate * CHUNK_MS / 1000, total - s.frame);
    let data = synth.chunk_ramp(t, s.frame, frames, s.volume_prev, s.volume);
    s.volume_prev = s.volume;
    match (audio.write(s.handle, data)) {
        Result.Ok(_) => {
            s.frame = s.frame + frames;
            s.written = s.written + frames;
            if (s.in_background) {
                s.background_ms = s.background_ms + CHUNK_MS;
            }
        },
        Result.Err(e) => {
            s.error = "audio: " + e;
            eprint("rayplay: " + s.error);
            stop(s);
        },
    }
}

/// The actor loop: run it in its own fiber with `spawn`.
pub fn run(cmds: Channel<Cmd>, tracks: [synth.Track]) -> unit {
    let s = State {
        tracks: tracks,
        current: 0,
        playing: false,
        paused: false,
        volume: 80,
        volume_prev: 80,
        handle: 0,
        base_ms: 0,
        frame: 0,
        written: 0,
        note: "",
        in_background: false,
        background_ms: 0,
        error: ""
    };
    var alive = true;
    while (alive) {
        if (s.playing && !s.paused && s.handle != 0) {
            // Playing: take what is queued without blocking, then feed the device (which
            // parks us for about a chunk when its buffer is full).
            var more = true;
            while (more) {
                match (try_recv(cmds)) {
                    Received.Got(c) => {
                        alive = handle(s, c);
                    },
                    Received.Empty => {
                        more = false;
                    },
                    Received.Closed => {
                        alive = false;
                        more = false;
                    },
                }
            }
            if (alive && s.playing && !s.paused && s.handle != 0) {
                feed(s);
            }
        } else {
            match (recv(cmds)) {
                Option.Some(c) => {
                    alive = handle(s, c);
                },
                Option.None => {
                    alive = false;
                },
            }
        }
    }
    close_output(s);
}

/// Asks the actor for a snapshot (from any other fiber).
pub fn query(cmds: Channel<Cmd>) -> Snapshot {
    let reply: Channel<Snapshot> = Channel.bounded(1);
    send(cmds, Cmd.Query(reply));
    match (recv(reply)) {
        Option.Some(snap) => snap,
        Option.None => Snapshot {
            tracks: [],
            current: 0,
            playing: false,
            paused: false,
            position_ms: 0,
            volume: 0,
            note: "",
            background_ms: 0,
            error: "player gone"
        },
    }
}

/// A clock stamp for lifecycle notes ("12:01:03").
pub fn stamp() -> string {
    let secs = time.now() / 1000 % 86400;
    let h = secs / 3600;
    let m = secs / 60 % 60;
    let sec = secs % 60;
    two(h) + ":" + two(m) + ":" + two(sec)
}

fn two(n: int) -> string {
    if (n < 10) { "0" + to_string(n) } else { to_string(n) }
}
