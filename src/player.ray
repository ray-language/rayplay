// The player: ONE fiber owns the audio output and the playlist, and everything else talks
// to it through a channel of commands (the actor pattern — fibers do not share a heap).
// Sound is written to std/audio in 50 ms chunks; `write` parks the fiber while the device
// is full, so the device sets the pace and commands are picked up between chunks.
//
// The output takes 24-bit samples (`audio.open_format`, "s24le"), so a 24-bit file reaches the
// device as it is.
//
// Position keeping: `audio.played_ms` counts from when the device was opened, and `base_ms`
// is what to add to it to get the position in the track. What is queued (on iOS, a quarter of
// a second or more) plays on after `close`, so a cut — a seek, a pause, a stop, another track
// chosen — discards it first with `audio.flush`, which ends the sound with a short fade. A seek
// or a change of track into the same rate and channels keeps the device and goes on writing; a
// track that ends runs into the next one without a gap, or, in another format, closes the
// device once its queue has played.

import std/audio;
import std/math;
import std/time;
import synth;

pub enum Cmd {
    Play(int),
    Toggle,
    Stop,
    Next,
    Prev,
    Seek(int),
    Volume(int),
    Add(synth.Track),
    Note(string),
    Query(Channel<Snapshot>),
    Quit,
}

/// What the page shows: the playlist and where playback is.
pub struct Snapshot {
    tracks: [(string, int)],
    current: int,
    playing: bool,
    paused: bool,
    position_ms: int,
    volume: int,
    /// The last lifecycle note ("background 12:01:03") and how much sounded since it.
    note: string,
    background_ms: int,
    error: string,
}

const CHUNK_MS: int = 50;

const LATENCY_MS: int = 120;

/// The fade-in after a cut: short enough not to be heard as a gap, long enough not to click.
const FADE_MS: int = 10;

struct State {
    tracks: [synth.Track],
    current: int,
    playing: bool,
    paused: bool,
    volume: int,
    /// The volume the last chunk ended at: the next one ramps from it to `volume`.
    volume_prev: int,
    handle: int,
    base_ms: int,
    frame: int,
    /// Frames written since the device was opened.
    written: int,
    note: string,
    in_background: bool,
    background_ms: int,
    error: string,
}

fn position_ms(s: State) -> int {
    if (s.playing && !s.paused && s.handle != 0) {
        let at = s.base_ms + audio.played_ms(s.handle).unwrap_or(0);
        if (at < 0) { 0 } else { at }
    } else {
        s.base_ms
    }
}

fn snapshot(s: State) -> Snapshot {
    var tracks: [(string, int)] = [];
    for t in s.tracks {
        tracks.push((t.name, t.duration_ms));
    }
    Snapshot {
        tracks: tracks,
        current: s.current,
        playing: s.playing,
        paused: s.paused,
        position_ms: position_ms(s),
        volume: s.volume,
        note: s.note,
        background_ms: s.background_ms,
        error: s.error
    }
}

/// Ends the output once what is queued has played.
fn close_output(s: State) -> unit {
    if (s.handle != 0) {
        let _d = audio.drain(s.handle);
        close(s.handle);
        s.handle = 0;
    }
}

/// Ends the output at once: what is queued is discarded, with a short fade.
fn cut_output(s: State) -> unit {
    if (s.handle != 0) {
        let _f = audio.flush(s.handle);
        close(s.handle);
        s.handle = 0;
    }
}

/// Opens the device for the current track at `ms` into it.
fn open_at(s: State, ms: int) -> unit {
    let t = s.tracks[s.current];
    match (audio.open_format(t.rate, t.channels, "s24le", LATENCY_MS)) {
        Result.Ok(h) => {
            s.handle = h;
            s.error = "";
        },
        Result.Err(e) => {
            s.error = "audio: " + e;
            s.playing = false;
            s.paused = false;
            eprint("rayplay: " + s.error);
        },
    }
    s.base_ms = ms;
    s.frame = ms * t.rate / 1000;
    s.written = 0;
    // The first chunk fades in from silence.
    s.volume_prev = 0;
}

/// Goes on at `ms` into the current track in the same output, after what is queued.
fn continue_at(s: State, ms: int) -> unit {
    let t = s.tracks[s.current];
    // The new position starts sounding once everything written so far has played.
    s.base_ms = ms - s.written * 1000 / t.rate;
    s.frame = ms * t.rate / 1000;
}

/// Moves playback to `ms` into the current track without reopening the device: what is queued
/// is discarded (it fades out) and the new position fades in right after what has played.
fn jump(s: State, ms: int) -> unit {
    let _f = audio.flush(s.handle);
    let t = s.tracks[s.current];
    let played = audio.played_ms(s.handle).unwrap_or(0);
    // From here on the output holds only what has played: the new position follows it.
    s.written = played * t.rate / 1000;
    s.base_ms = ms - played;
    s.frame = ms * t.rate / 1000;
    fade_in(s);
}

/// Writes the next few milliseconds of the current track rising from silence.
fn fade_in(s: State) -> unit {
    let t = s.tracks[s.current];
    let frames = t.rate * FADE_MS / 1000;
    write_counted(s, synth.chunk_ramp(t, s.frame, frames, 0, s.volume), frames);
    s.frame = s.frame + frames;
    s.volume_prev = s.volume;
}

/// Writes `data` (`frames` frames); a failed write is left for `feed` to report.
fn write_counted(s: State, data: bytes, frames: int) -> unit {
    if let Result.Ok(_) = audio.write(s.handle, data) {
        s.written = s.written + frames;
    }
}

/// Plays track `index` from `ms`. While playing into an output of the same rate and channels,
/// the output goes on: a track that ended runs into the next without a gap, and one that is
/// cut jumps there at once. Otherwise the output is closed — once its queue has played if the
/// track ended, at once if it was cut — and a new one opened.
fn start(s: State, index: int, ms: int) -> unit {
    if (s.tracks.len() == 0) {
        return;
    }
    let i = (index % s.tracks.len() + s.tracks.len()) % s.tracks.len();
    let from = s.tracks[s.current];
    let to = s.tracks[i];
    let ended = s.frame >= synth.total_frames(from);
    if (s.playing
        && !s.paused
        && s.handle != 0
        && from.rate == to.rate
        && from.channels == to.channels) {
        s.current = i;
        if (!ended) {
            jump(s, ms);
        } else {
            continue_at(s, ms);
            if (ms > 0) {
                fade_in(s);
            }
        }
        return;
    }
    if (ended) {
        close_output(s);
    } else {
        cut_output(s);
    }
    s.current = i;
    s.playing = true;
    s.paused = false;
    open_at(s, ms);
}

fn stop(s: State) -> unit {
    cut_output(s);
    s.playing = false;
    s.paused = false;
    s.base_ms = 0;
    s.frame = 0;
}

/// Pauses where the sound stops: what is queued is discarded, with a short fade.
fn pause(s: State) -> unit {
    let t = s.tracks[s.current];
    if (s.handle != 0) {
        let _f = audio.flush(s.handle);
    }
    // After the flush, what has played is all that will.
    let at = math.min(position_ms(s), t.duration_ms);
    s.paused = true;
    if (s.handle != 0) {
        close(s.handle);
        s.handle = 0;
    }
    s.base_ms = at;
    s.frame = at * t.rate / 1000;
}

fn handle(s: State, cmd: Cmd) -> bool {
    match (cmd) {
        Cmd.Play(i) => start(s, i, 0),
        Cmd.Toggle => {
            if (!s.playing) {
                start(s, s.current, 0);
            } else if (s.paused) {
                start(s, s.current, s.base_ms);
            } else {
                pause(s);
            }
        },
        Cmd.Stop => stop(s),
        Cmd.Next => step(s, 1),
        Cmd.Prev => step(s, s.tracks.len() - 1),
        Cmd.Seek(ms) => {
            let t = s.tracks[s.current];
            let clamped = if (ms < 0) {
                0
            } else if (ms > t.duration_ms) {
                t.duration_ms
            } else {
                ms
            };
            if (s.playing && !s.paused && s.handle != 0) {
                jump(s, clamped);
            } else if (s.playing && !s.paused) {
                start(s, s.current, clamped);
            } else {
                s.base_ms = clamped;
                s.frame = clamped * t.rate / 1000;
            }
        },
        Cmd.Volume(v) => {
            s.volume = if (v < 0) { 0 } else if (v > 100) { 100 } else { v };
        },
        Cmd.Add(t) => {
            s.tracks.push(t);
        },
        Cmd.Note(n) => {
            s.note = n;
            s.in_background = n.starts_with("background");
            if (s.in_background) {
                s.background_ms = 0;
            }
        },
        Cmd.Query(reply) => send(reply, snapshot(s)),
        Cmd.Quit => {
            stop(s);
            return false;
        },
    }
    true
}

/// Moves `by` tracks along the playlist: playing it if a track was playing or paused.
fn step(s: State, by: int) -> unit {
    if (s.tracks.len() == 0) {
        return;
    }
    let next = (s.current + by) % s.tracks.len();
    if (s.playing) {
        start(s, next, 0);
    } else {
        stop(s);
        s.current = next;
    }
}

/// Writes the next chunk of the current track; at the end, moves to the next track.
fn feed(s: State) -> unit {
    let t = s.tracks[s.current];
    let total = synth.total_frames(t);
    if (s.frame >= total) {
        start(s, s.current + 1, 0);
        return;
    }
    // The last chunk stops at the end of the track, so the next one follows without a gap.
    let frames = math.min(t.rate * CHUNK_MS / 1000, total - s.frame);
    let data = synth.chunk_ramp(t, s.frame, frames, s.volume_prev, s.volume);
    s.volume_prev = s.volume;
    match (audio.write(s.handle, data)) {
        Result.Ok(_) => {
            s.frame = s.frame + frames;
            s.written = s.written + frames;
            if (s.in_background) {
                s.background_ms = s.background_ms + CHUNK_MS;
            }
        },
        Result.Err(e) => {
            s.error = "audio: " + e;
            eprint("rayplay: " + s.error);
            stop(s);
        },
    }
}

/// The actor loop: run it in its own fiber with `spawn`.
pub fn run(cmds: Channel<Cmd>, tracks: [synth.Track]) -> unit {
    let s = State {
        tracks: tracks,
        current: 0,
        playing: false,
        paused: false,
        volume: 80,
        volume_prev: 80,
        handle: 0,
        base_ms: 0,
        frame: 0,
        written: 0,
        note: "",
        in_background: false,
        background_ms: 0,
        error: ""
    };
    var alive = true;
    while (alive) {
        if (s.playing && !s.paused && s.handle != 0) {
            // Playing: take what is queued without blocking, then feed the device (which
            // parks us for about a chunk when its buffer is full).
            var more = true;
            while (more) {
                match (try_recv(cmds)) {
                    Received.Got(c) => {
                        alive = handle(s, c);
                    },
                    Received.Empty => {
                        more = false;
                    },
                    Received.Closed => {
                        alive = false;
                        more = false;
                    },
                }
            }
            if (alive && s.playing && !s.paused && s.handle != 0) {
                feed(s);
            }
        } else {
            match (recv(cmds)) {
                Option.Some(c) => {
                    alive = handle(s, c);
                },
                Option.None => {
                    alive = false;
                },
            }
        }
    }
    cut_output(s);
}

/// Asks the actor for a snapshot (from any other fiber).
pub fn query(cmds: Channel<Cmd>) -> Snapshot {
    let reply: Channel<Snapshot> = Channel.bounded(1);
    send(cmds, Cmd.Query(reply));
    match (recv(reply)) {
        Option.Some(snap) => snap,
        Option.None => Snapshot {
            tracks: [],
            current: 0,
            playing: false,
            paused: false,
            position_ms: 0,
            volume: 0,
            note: "",
            background_ms: 0,
            error: "player gone"
        },
    }
}

/// A clock stamp for lifecycle notes ("12:01:03").
pub fn stamp() -> string {
    let secs = time.now() / 1000 % 86400;
    let h = secs / 3600;
    let m = secs / 60 % 60;
    let sec = secs % 60;
    two(h) + ":" + two(m) + ":" + two(sec)
}

fn two(n: int) -> string {
    if (n < 10) { "0" + to_string(n) } else { to_string(n) }
}
