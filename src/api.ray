// The page ↔ program protocol over `window.ray.request({op, …})`: every request is answered
// with the player's snapshot as JSON (`ok: true`) or `{ok: false, error}`. A loaded file is
// the exception: it comes as a plain string, not JSON (see `add` below).
//
//   state                      → the snapshot
//   play {index}               → start that track from the beginning
//   toggle                     → play / pause / resume the current track
//   stop · next · prev
//   seek {ms} · volume {value}
//   pick                       → the native file dialog; the chosen file (WAV, AIFF, FLAC, MP3) is
//                                read from disk and appended to the playlist (FLAC and MP3
//                                are decoded as they play)
//                                (cancelling changes nothing)
//   "add:<name>\n<base64>"     → a WAV, AIFF, FLAC or MP3 from the page's file input, added to the
//                                playlist; for a shell without a native dialog (iOS). A plain
//                                string because `json.parse` costs ~55× a long string
//                                (findings #150): a 56 MB WAV inside JSON blows the phone's
//                                memory limit; decoded with `b64` over the request's octets,
//                                which std/base64 (a `string` in) cannot do (#161).

import std/fs;
import std/json;
import std/ui;
import b64;
import codec;
import player;
import synth;

fn fail(msg: string) -> string {
    json.obj().field("ok", false).field("error", msg).render()
}

fn track_json(t: (string, int)) -> string {
    json.obj().field("name", t.0).field("duration_ms", t.1).render()
}

/// The snapshot as the page reads it.
pub fn snapshot_json(s: player.Snapshot) -> string {
    var items: [string] = [];
    for t in s.tracks {
        items.push(track_json(t));
    }
    let tracks = "[" + items.join(",") + "]";
    let head = json.obj()
        .field("ok", true)
        .field("current", s.current)
        .field("playing", s.playing)
        .field("paused", s.paused)
        .field("position_ms", s.position_ms)
        .field("volume", s.volume)
        .field("note", s.note)
        .field("background_ms", s.background_ms)
        .field("error", s.error)
        .render();
    // Splice the array in: the builder has no raw-JSON field.
    head.substring(0, head.len() - 1) + ",\"tracks\":" + tracks + "}"
}

fn int_field(req: json.Json, key: string) -> Result<int, string> {
    match (json.get_int(req, key)) {
        Option.Some(n) => Result.Ok(n),
        Option.None => Result.Err("missing field '${key}'"),
    }
}

fn str_field(req: json.Json, key: string) -> Result<string, string> {
    match (json.get_string(req, key)) {
        Option.Some(s) => Result.Ok(s),
        Option.None => Result.Err("missing field '${key}'"),
    }
}

/// The track name of a file: its base name without an audio extension.
pub fn track_name(path: string) -> string {
    let parts = path.replace("\\", "/").split("/");
    let base = parts[parts.len() - 1];
    for ext in codec.extensions() {
        if (base.to_lower().ends_with("." + ext)) {
            return base.substring(0, base.len() - ext.len() - 1);
        }
    }
    base
}

/// Lets the user choose a file with the native dialog and reads it straight from disk, so the
/// file never crosses the page bridge (a large one there costs far more than its size).
/// `Ok(false)` if the user cancelled.
fn pick(cmds: Channel<player.Cmd>) -> Result<bool, string> {
    var o = ui.file_options();
    o.title = "Load a song (MP3, FLAC, WAV or AIFF)";
    o.filters = [ui.filter("Audio", codec.extensions())];
    // A dialog failure is told apart so the page can fall back to its own file input.
    let chosen = ui.pick_file_with(o).map_err(fn(e: string) -> string { "dialog: " + e })?;
    match (chosen) {
        Option.Some(path) => {
            let src = codec.open(fs.read_file_bytes(path)?)?;
            send(cmds, player.Cmd.Add(synth.of_source(track_name(path), src)));
            Result.Ok(true)
        },
        Option.None => Result.Ok(false),
    }
}

/// `add:<name>\n<base64>`: opens the file and appends it to the playlist.
fn add(cmds: Channel<player.Cmd>, body: string) -> Result<unit, string> {
    // As octets: `b[i]` and `sub_bytes` are O(1), unlike indexing the string by character.
    let b = body.to_bytes();
    let cut = match (b.index_of(bytes_of([10]))) {
        Option.Some(i) => i,
        Option.None => return Result.Err("add: missing the file after the name"),
    };
    let name = from_utf8(b.sub_bytes(4, cut))?;
    let src = codec.open(b64.decode(b, cut + 1)?)?;
    Result.Ok(send(cmds, player.Cmd.Add(synth.of_source(name, src))))
}

fn dispatch(cmds: Channel<player.Cmd>, body: string) -> Result<string, string> {
    if (body.starts_with("add:")) {
        add(cmds, body)?;
        return Result.Ok(snapshot_json(player.query(cmds)));
    }
    let req = json.parse(body)?;
    let op = str_field(req, "op")?;
    match (op) {
        "state" => { },
        "play" => send(cmds, player.Cmd.Play(int_field(req, "index")?)),
        "toggle" => send(cmds, player.Cmd.Toggle),
        "stop" => send(cmds, player.Cmd.Stop),
        "next" => send(cmds, player.Cmd.Next),
        "prev" => send(cmds, player.Cmd.Prev),
        "seek" => send(cmds, player.Cmd.Seek(int_field(req, "ms")?)),
        "volume" => send(cmds, player.Cmd.Volume(int_field(req, "value")?)),
        "pick" => {
            pick(cmds)?;
        },
        _ => return Result.Err("unknown op: ${op}"),
    }
    Result.Ok(snapshot_json(player.query(cmds)))
}

/// Handles one request body; always returns a JSON reply.
pub fn handle(cmds: Channel<player.Cmd>, body: string) -> string {
    match (dispatch(cmds, body)) {
        Result.Ok(reply) => reply,
        Result.Err(e) => {
            eprint("rayplay: request failed: " + e);
            fail(e)
        },
    }
}
