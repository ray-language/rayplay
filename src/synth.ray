// The tracks. Three are procedural — a few minutes of sound computed chunk by chunk, so the
// app ships no audio files and no track ever sits whole in memory — and any 16-bit WAV the
// user loads becomes a fourth kind. `chunk` renders any window of a track as s16le at the
// track's rate, which is all the player needs.

import std/math;
import wav;

pub enum Kind {
    Etude,
    Drone,
    Pulse,
    Loaded(wav.Pcm),
}

pub struct Track {
    name: string,
    kind: Kind,
    rate: int,
    channels: int,
    duration_ms: int,
}

/// The built-in playlist.
pub fn builtin() -> [Track] {
    [
        Track {
            name: "Pentatonic Etude",
            kind: Kind.Etude,
            rate: 44100,
            channels: 2,
            duration_ms: 180000
        },
        Track {
            name: "Slow Drone",
            kind: Kind.Drone,
            rate: 44100,
            channels: 2,
            duration_ms: 120000
        },
        Track { name: "Pulse Bass", kind: Kind.Pulse, rate: 44100, channels: 2, duration_ms: 90000 }
    ]
}

/// A track from a WAV file the user loaded.
pub fn loaded(name: string, p: wav.Pcm) -> Track {
    Track {
        name: name,
        kind: Kind.Loaded(p),
        rate: p.rate,
        channels: p.channels,
        duration_ms: wav.duration_ms(p)
    }
}

/// Frames in the track: exact for a loaded file, from the duration for a procedural one.
pub fn total_frames(t: Track) -> int {
    match (t.kind) {
        Kind.Loaded(p) => wav.frames(p),
        _ => t.duration_ms * t.rate / 1000,
    }
}

// ---- procedural voices (stereo float in -1..1) ----

// A minor pentatonic over two octaves, as frequencies.
const SCALE: [float] = [
    220.0,
    261.63,
    293.66,
    329.63,
    392.0,
    440.0,
    523.25,
    587.33,
    659.25,
    783.99
];

fn etude(t: float) -> (float, float) {
    // 240 ms per note; the note index walks a fixed pattern over the scale.
    let step = (t / 0.24) as int;
    let pattern = [0, 2, 4, 7, 5, 4, 2, 1, 3, 5, 8, 9, 7, 5, 3, 2];
    let f = SCALE[pattern[step % pattern.len()]];
    let phase = t - (step as float) * 0.24;
    let env = math.exp(0.0 - phase * 6.0);
    let s = math.sin(2.0 * math.PI * f * t) * 0.8 + math.sin(4.0 * math.PI * f * t) * 0.2;
    let v = s * env * 0.6;
    // A slow pan so the two channels differ audibly.
    let pan = 0.5 + 0.5 * math.sin(t * 0.7);
    (v * (1.0 - pan * 0.6), v * (0.4 + pan * 0.6))
}

fn drone(t: float) -> (float, float) {
    let lfo = 0.5 + 0.5 * math.sin(2.0 * math.PI * 0.05 * t);
    let a = math.sin(2.0 * math.PI * 110.0 * t);
    let b = math.sin(2.0 * math.PI * 110.7 * t);
    let c = math.sin(2.0 * math.PI * 165.0 * t) * lfo;
    let v = (a + b + c) * 0.18;
    (v, v * 0.9 + math.sin(2.0 * math.PI * 220.4 * t) * 0.05)
}

fn pulse(t: float) -> (float, float) {
    // A 100 BPM bass pulse: a sine that drops in pitch and dies within the beat.
    let beat = 0.6;
    let phase = t - math.floor(t / beat) * beat;
    let f = 55.0 + 40.0 * math.exp(0.0 - phase * 12.0);
    let env = math.exp(0.0 - phase * 4.0);
    let v = math.sin(2.0 * math.PI * f * phase) * env * 0.7;
    (v, v)
}

fn clamp16(x: float) -> int {
    var v = (x * 32768.0) as int;
    if (v > 32767) {
        v = 32767;
    }
    if (v < -32768) {
        v = -32768;
    }
    if (v < 0) { v + 65536 } else { v }
}

/// `frames` frames of `t` starting at `from` (frames), as s16le at `volume` (0–100).
/// Past the end of the track it renders silence, so a caller can always ask for a full chunk.
pub fn chunk(t: Track, from: int, frames: int, volume: int) -> bytes {
    let gain = (volume as float) / 100.0;
    var out: [int] = [];
    let end = total_frames(t);
    match (t.kind) {
        Kind.Loaded(p) => {
            let block = 2 * p.channels;
            for i in 0..frames {
                let fr = from + i;
                for ch in 0..t.channels {
                    var sample = 0;
                    if (fr < end) {
                        let at = fr * block + ch * 2;
                        var v = p.data[at] + p.data[at + 1] * 256;
                        if (v >= 32768) {
                            v = v - 65536;
                        }
                        sample = clamp16(((v as float) / 32768.0) * gain);
                    }
                    out.push(sample % 256);
                    out.push(sample / 256);
                }
            }
        },
        _ => {
            for i in 0..frames {
                let fr = from + i;
                var l = 0.0;
                var r = 0.0;
                if (fr < end) {
                    let time = (fr as float) / (t.rate as float);
                    let lr = match (t.kind) {
                        Kind.Etude => etude(time),
                        Kind.Drone => drone(time),
                        _ => pulse(time),
                    };
                    l = lr.0 * gain;
                    r = lr.1 * gain;
                }
                let sl = clamp16(l);
                let sr = clamp16(r);
                out.push(sl % 256);
                out.push(sl / 256);
                out.push(sr % 256);
                out.push(sr / 256);
            }
        },
    }
    bytes_of(out)
}
