// Turns an audio file into 16-bit PCM for the player, whatever its format: WAV, AIFF, FLAC or
// MP3, recognized by their content (not the file name). An ID3v2 tag in front is skipped.
//
// Every file stays as it came and is turned into PCM while it plays: a `Stream` holds the file
// and serves any window of the track with `read`. A WAV or AIFF is PCM already, so a window is
// read straight from the file (`wav.Raw`). FLAC and MP3 go through their decoder, with the few
// thousand samples decoded ahead in a buffer, seeking when a window is not the next one. So a
// song starts at once and costs its file size.

import aiff;
import flac;
import mp3;
import wav;

/// The extensions the file dialogs and the page offer.
pub fn extensions() -> [string] {
    ["wav", "aiff", "aif", "aifc", "flac", "mp3"]
}

fn starts(b: bytes, at: int, tag: string) -> bool {
    let t = tag.to_bytes();
    at + t.len() <= b.len() && b.sub_bytes(at, at + t.len()) == t
}

/// Where the audio starts once a leading ID3v2 tag (or several) is skipped.
pub fn skip_id3(b: bytes) -> int {
    var at = 0;
    while (starts(b, at, "ID3") && at + 10 <= b.len()) {
        // Syncsafe size: 4 × 7 bits, not counting the 10-byte header (nor the footer).
        let size = (b[at + 6] << 21) | (b[at + 7] << 14) | (b[at + 8] << 7) | b[at + 9];
        let footer = if ((b[at + 5] & 16) != 0) { 10 } else { 0 };
        at = at + 10 + size + footer;
    }
    if (at > b.len()) { b.len() } else { at }
}

enum Decoder {
    Raw(wav.Raw),
    Flac(flac.Stream),
    Mp3(mp3.Stream),
}

/// A loaded file being played.
pub struct Stream {
    dec: Decoder,
    rate: int,
    channels: int,
    /// Frames (samples per channel) in the track.
    total: int,
    /// Decoded samples (interleaved, signed 16-bit) and the frame the first one is.
    buf: [int],
    buf_from: int,
}

fn stream_of(dec: Decoder, rate: int, channels: int, total: int) -> Stream {
    Stream { dec: dec, rate: rate, channels: channels, total: total, buf: [], buf_from: 0 }
}

fn raw_stream(r: wav.Raw) -> Stream {
    stream_of(Decoder.Raw(r), r.rate, r.channels, r.frames)
}

/// Recognizes `b` as WAV, AIFF, FLAC or MP3 and gets it ready to play.
pub fn open(b: bytes) -> Result<Stream, string> {
    if (starts(b, 0, "RIFF")) {
        return Result.Ok(raw_stream(wav.open(b)?));
    }
    if (starts(b, 0, "FORM")) {
        return Result.Ok(raw_stream(aiff.open(b)?));
    }
    let at = skip_id3(b);
    if (starts(b, at, "fLaC")) {
        let f = flac.open(b, at)?;
        return Result.Ok(stream_of(Decoder.Flac(f), f.rate, f.channels, f.total));
    }
    let looks_mp3 = at + 1 < b.len() && b[at] == 255 && (b[at + 1] & 0xE0) == 0xE0;
    // Some MP3s carry junk before the first frame: the indexer looks for one anyway.
    match (mp3.open(b, at)) {
        Result.Ok(m) => Result.Ok(stream_of(Decoder.Mp3(m), m.rate, m.channels, m.total)),
        Result.Err(e) => Result.Err(if (looks_mp3) { e } else { "not a WAV, AIFF, FLAC or MP3 file" }),
    }
}

/// Decodes the next block into `out`; its first frame, or None at the end.
fn decode_next(s: Stream, out: [int]) -> Option<int> {
    match (s.dec) {
        Decoder.Flac(f) => flac.next(f, out),
        Decoder.Mp3(m) => mp3.next(m, out),
        Decoder.Raw(_) => Option.None,
    }
}

fn seek(s: Stream, pos: int) -> unit {
    match (s.dec) {
        Decoder.Flac(f) => flac.seek(f, pos),
        Decoder.Mp3(m) => mp3.seek(m, pos),
        Decoder.Raw(_) => { },
    }
    s.buf = [];
    s.buf_from = pos;
}

/// `frames` frames of the track from frame `from`, as interleaved signed 16-bit samples;
/// silence past the end. Reading on from where the last read ended only decodes what is new;
/// anything else (a seek, a restart) repositions the decoder first.
pub fn read(s: Stream, from: int, frames: int) -> [int] {
    if let Decoder.Raw(r) = s.dec {
        return read_raw(r, from, frames);
    }
    let ch = s.channels;
    var buf_end = s.buf_from + s.buf.len() / ch;
    // Behind the buffer, or more than half a second past it: reposition instead of decoding on.
    if (from < s.buf_from || from > buf_end + s.rate / 2) {
        seek(s, from);
    }
    // Drop what is behind `from`, so the buffer holds little more than a block.
    if (from > s.buf_from && s.buf.len() > 0) {
        let old = s.buf;
        let skip = (from - s.buf_from) * ch;
        var kept: [int] = [];
        let n = old.len();
        var i = skip;
        while (i < n) {
            kept.push(old[i]);
            i = i + 1;
        }
        s.buf = kept;
        s.buf_from = if (skip < n) { from } else { s.buf_from + n / ch };
    }
    buf_end = s.buf_from + s.buf.len() / ch;
    let want = if (from + frames < s.total) { from + frames } else { s.total };
    var more = true;
    while (buf_end < want && more) {
        var block: [int] = [];
        match (decode_next(s, block)) {
            Option.Some(first) => {
                if (first != buf_end || s.buf.len() == 0) {
                    // Not where the buffer ends (the first block after a seek starts at or
                    // before the frame asked for): start the buffer over at it.
                    s.buf = block;
                    s.buf_from = first;
                } else {
                    let buf = s.buf;
                    for v in block {
                        buf.push(v);
                    }
                }
                buf_end = s.buf_from + s.buf.len() / ch;
            },
            Option.None => {
                more = false;
            },
        }
    }
    let buf = s.buf;
    let base = s.buf_from;
    var out: [int] = [];
    for i in 0..frames {
        let f = from + i;
        let inside = f < s.total && f >= base && f < buf_end;
        for c in 0..ch {
            out.push(if (inside) { buf[(f - base) * ch + c] } else { 0 });
        }
    }
    out
}

/// A window of PCM still in its file: no buffer, no state.
fn read_raw(r: wav.Raw, from: int, frames: int) -> [int] {
    let ch = r.channels;
    var out: [int] = [];
    for f in from..from + frames {
        for c in 0..ch {
            out.push(if (f >= 0 && f < r.frames) { wav.sample(r, f * ch + c) } else { 0 });
        }
    }
    out
}

/// Decodes `b` whole, as WAV, AIFF, FLAC or MP3 (tests and tools; the player streams).
pub fn decode(b: bytes) -> Result<wav.Pcm, string> {
    let s = open(b)?;
    if let Decoder.Raw(r) = s.dec {
        return Result.Ok(wav.to_pcm(r));
    }
    let sink = wav.sink();
    let step = s.rate;
    var at = 0;
    while (at < s.total) {
        let n = if (at + step < s.total) { step } else { s.total - at };
        for v in read(s, at, n) {
            wav.put(sink, v);
        }
        at = at + n;
    }
    Result.Ok(wav.Pcm { rate: s.rate, channels: s.channels, data: wav.finish(sink) })
}
