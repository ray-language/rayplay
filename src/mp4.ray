// The MP4 / M4A container (ISO base media file format, as iTunes and afconvert write it): finds
// the first sound track and turns its sample tables into where each packet is in the file and
// which frame it starts at. It does not decode anything; `alac` does, packet by packet.

/// The first sound track of a file.
pub struct Track {
    /// The sample entry's format: "alac", "mp4a" (AAC)…
    format: string,
    rate: int,
    channels: int,
    /// The decoder's own configuration (for ALAC, the 24-octet ALACSpecificConfig).
    config: bytes,
    /// Each packet's offset and size in the file, and the frame it starts at (in samples at
    /// `rate`, from the time-to-sample table).
    offsets: [int],
    sizes: [int],
    starts: [int],
    /// Frames in the track.
    total: int,
    /// The media's time scale (units per second of `skip` and `length`).
    timescale: int,
    /// From the edit list: how much of the decoded media to drop at the start (an encoder's
    /// priming) and how much to play after that (0 when the file does not say).
    skip: int,
    length: int,
}

fn be16(b: bytes, at: int) -> int {
    (b[at] << 8) | b[at + 1]
}

fn be32(b: bytes, at: int) -> int {
    (b[at] << 24) | (b[at + 1] << 16) | (b[at + 2] << 8) | b[at + 3]
}

fn tag(b: bytes, at: int) -> string {
    from_utf8(b.sub_bytes(at, at + 4)).unwrap_or("")
}

/// The body (`from`, `to`) of the first `kind` box among the boxes in `from..to`.
fn child(b: bytes, from: int, to: int, kind: string) -> Option<(int, int)> {
    var at = from;
    while (at + 8 <= to) {
        var size = be32(b, at);
        var head = 8;
        if (size == 1) {
            if (at + 16 > to) {
                return Option.None;
            }
            size = (be32(b, at + 8) << 32) | be32(b, at + 12);
            head = 16;
        } else if (size == 0) {
            size = to - at;
        }
        if (size < head || at + size > to) {
            return Option.None;
        }
        if (tag(b, at + 4) == kind) {
            return Option.Some((at + head, at + size));
        }
        at = at + size;
    }
    Option.None
}

fn path(b: bytes, from: int, to: int, kinds: [string]) -> Option<(int, int)> {
    var range = (from, to);
    for k in kinds {
        match (child(b, range.0, range.1, k)) {
            Option.Some(r) => {
                range = r;
            },
            Option.None => return Option.None,
        }
    }
    Option.Some(range)
}

/// True when `b` looks like an MP4: an `ftyp` box first.
pub fn sniff(b: bytes) -> bool {
    b.len() >= 12 && tag(b, 4) == "ftyp"
}

/// The `trak` boxes inside `moov`, in order.
fn tracks(b: bytes, moov: (int, int)) -> [(int, int)] {
    var out: [(int, int)] = [];
    var at = moov.0;
    while (true) {
        match (child(b, at, moov.1, "trak")) {
            Option.Some(t) => {
                out.push(t);
                at = t.1;
            },
            Option.None => return out,
        }
    }
    out
}

/// Opens the first sound track of an MP4 file.
pub fn open(b: bytes) -> Result<Track, string> {
    if (!sniff(b)) {
        return Result.Err("not an MP4 file");
    }
    let moov = match (child(b, 0, b.len(), "moov")) {
        Option.Some(m) => m,
        Option.None => return Result.Err("MP4 without a moov box"),
    };
    for trak in tracks(b, moov) {
        if let Option.Some(hdlr) = path(b, trak.0, trak.1, ["mdia", "hdlr"]) {
            if (hdlr.0 + 12 <= hdlr.1 && tag(b, hdlr.0 + 8) == "soun") {
                return sound_track(b, moov, trak);
            }
        }
    }
    Result.Err("MP4 without a sound track")
}

/// The time scale of a `mvhd` or `mdhd` box (version 0 or 1).
fn timescale_of(b: bytes, box: (int, int)) -> int {
    let at = box.0 + if (b[box.0] == 1) { 20 } else { 12 };
    if (at + 4 <= box.1) { be32(b, at) } else { 0 }
}

/// The first edit that plays media: (media time, duration in the movie's time scale).
fn first_edit(b: bytes, trak: (int, int)) -> (int, int) {
    let elst = match (path(b, trak.0, trak.1, ["edts", "elst"])) {
        Option.Some(e) => e,
        Option.None => return (0, 0),
    };
    let wide = b[elst.0] == 1;
    let n = be32(b, elst.0 + 4);
    let size = if (wide) { 20 } else { 12 };
    for i in 0..n {
        let at = elst.0 + 8 + size * i;
        if (at + size > elst.1) {
            break;
        }
        let duration = if (wide) { (be32(b, at) << 32) | be32(b, at + 4) } else { be32(b, at) };
        let media = if (wide) {
            (be32(b, at + 8) << 32) | be32(b, at + 12)
        } else {
            be32(b, at + 4)
        };
        // An empty edit (media time -1) only delays the start.
        let empty = if (wide) { media == -1 } else { media == 0xFFFFFFFF };
        if (!empty) {
            return (media, duration);
        }
    }
    (0, 0)
}

/// iTunes' gapless information, when there is no edit list: the `iTunSMPB` tag in the movie's
/// metadata, a text of hexadecimal fields (0, the encoder delay, the padding, the length).
fn itunes_gapless(b: bytes, moov: (int, int)) -> (int, int) {
    let name = "iTunSMPB".to_bytes();
    let at = match (b.index_of_from(name, moov.0)) {
        Option.Some(i) if i < moov.1 => i,
        _ => return (0, 0),
    };
    // The `data` box that follows: size, "data", type, locale, then the text.
    let data = at + 8;
    if (data + 16 > moov.1 || tag(b, data + 4) != "data") {
        return (0, 0);
    }
    let end = data + be32(b, data);
    if (end > moov.1) {
        return (0, 0);
    }
    let text = from_utf8(b.sub_bytes(data + 16, end)).unwrap_or("");
    var fields: [int] = [];
    for f in text.split(" ") {
        if (f.len() > 0) {
            fields.push(hex(f));
        }
    }
    if (fields.len() < 4 || fields[1] < 0 || fields[3] < 0) {
        (0, 0)
    } else {
        (fields[1], fields[3])
    }
}

/// A hexadecimal number, or -1.
fn hex(s: string) -> int {
    var v = 0;
    for c in s.chars() {
        let d = "0123456789ABCDEF".index_of(to_string(c).to_upper());
        match (d) {
            Option.Some(x) => v = v * 16 + x,
            Option.None => return -1,
        }
    }
    v
}

/// The decoder configuration in an `esds` box: the DecoderSpecificInfo inside the
/// DecoderConfigDescriptor inside the ES_Descriptor (for AAC, the AudioSpecificConfig).
fn esds_config(b: bytes, esds: (int, int)) -> Option<bytes> {
    // Version and flags, then descriptors: a tag octet and a size of 7 bits per octet.
    var at = esds.0 + 4;
    var end = esds.1;
    while (at + 2 <= end) {
        let tag = b[at];
        var size = 0;
        var i = at + 1;
        var more = true;
        while (more && i < end && i < at + 5) {
            size = (size << 7) | (b[i] & 0x7F);
            more = (b[i] & 0x80) != 0;
            i = i + 1;
        }
        let body_end = if (i + size < end) { i + size } else { end };
        if (tag == 3) {
            // ES_Descriptor: ES_ID, flags, and what the flags add.
            let flags = b[i + 2];
            var inner = i + 3;
            if ((flags & 0x80) != 0) {
                inner = inner + 2;
            }
            if ((flags & 0x40) != 0) {
                inner = inner + 1 + b[inner];
            }
            if ((flags & 0x20) != 0) {
                inner = inner + 2;
            }
            at = inner;
            end = body_end;
        } else if (tag == 4) {
            // DecoderConfigDescriptor: object type, stream type, buffer size and bitrates.
            at = i + 13;
            end = body_end;
        } else if (tag == 5) {
            return Option.Some(b.sub_bytes(i, body_end));
        } else {
            at = body_end;
        }
    }
    Option.None
}

fn sound_track(b: bytes, moov: (int, int), trak: (int, int)) -> Result<Track, string> {
    let stbl = match (path(b, trak.0, trak.1, ["mdia", "minf", "stbl"])) {
        Option.Some(s) => s,
        Option.None => return Result.Err("MP4: sound track without a sample table"),
    };
    let stsd = match (child(b, stbl.0, stbl.1, "stsd")) {
        Option.Some(s) => s,
        Option.None => return Result.Err("MP4: no sample description"),
    };
    // The first sample entry: size, format, 6 reserved, data reference, then the audio fields.
    let entry = stsd.0 + 8;
    if (entry + 36 > stsd.1) {
        return Result.Err("MP4: short sample description");
    }
    let entry_end = entry + be32(b, entry);
    let format = tag(b, entry + 4);
    let version = be16(b, entry + 16);
    var channels = be16(b, entry + 24);
    var rate = be16(b, entry + 32);
    // QuickTime sound entries of version 1 and 2 carry 16 and 36 more octets before the boxes.
    let boxes = entry + 36 + if (version == 1) { 16 } else if (version == 2) { 36 } else { 0 };
    var config = bytes_of([]);
    if (format == "alac") {
        match (child(b, boxes, entry_end, "alac")) {
            Option.Some(c) => {
                if (c.0 + 28 > c.1) {
                    return Result.Err("ALAC: short configuration");
                }
                // Version and flags, then ALACSpecificConfig.
                config = b.sub_bytes(c.0 + 4, c.0 + 28);
                channels = config[9];
                rate = be32(config, 20);
            },
            Option.None => return Result.Err("ALAC without its configuration box"),
        }
    } else if (format == "mp4a") {
        if let Option.Some(e) = child(b, boxes, entry_end, "esds") {
            if let Option.Some(c) = esds_config(b, e) {
                config = c;
            }
        }
    }
    let starts = time_to_sample(b, stbl)?;
    let (offsets, sizes) = sample_offsets(b, stbl)?;
    if (offsets.len() == 0 || offsets.len() + 1 != starts.len()) {
        return Result.Err("MP4: sample tables that do not agree");
    }
    let total = starts[starts.len() - 1];
    let _end = starts.pop();
    let movie_scale = match (child(b, moov.0, moov.1, "mvhd")) {
        Option.Some(m) => timescale_of(b, m),
        Option.None => 0,
    };
    let media_scale = match (path(b, trak.0, trak.1, ["mdia", "mdhd"])) {
        Option.Some(m) => timescale_of(b, m),
        Option.None => 0,
    };
    let edit = first_edit(b, trak);
    var skip = edit.0;
    var length = if (movie_scale > 0) { edit.1 * media_scale / movie_scale } else { 0 };
    if (skip == 0 && length == 0) {
        let gapless = itunes_gapless(b, moov);
        skip = gapless.0;
        length = gapless.1;
    }
    Result.Ok(
        Track {
            format: format,
            rate: rate,
            channels: channels,
            config: config,
            offsets: offsets,
            sizes: sizes,
            starts: starts,
            total: total,
            timescale: media_scale,
            skip: skip,
            length: length
        }
    )
}

/// The frame each sample starts at, plus where the last one ends (from `stts`).
fn time_to_sample(b: bytes, stbl: (int, int)) -> Result<[int], string> {
    let stts = match (child(b, stbl.0, stbl.1, "stts")) {
        Option.Some(s) => s,
        Option.None => return Result.Err("MP4: no time-to-sample table"),
    };
    let n = be32(b, stts.0 + 4);
    if (stts.0 + 8 + 8 * n > stts.1) {
        return Result.Err("MP4: short time-to-sample table");
    }
    var starts: [int] = [0];
    var t = 0;
    for e in 0..n {
        let count = be32(b, stts.0 + 8 + 8 * e);
        let delta = be32(b, stts.0 + 12 + 8 * e);
        for _ in 0..count {
            t = t + delta;
            starts.push(t);
        }
    }
    Result.Ok(starts)
}

/// Each sample's offset and size, from the chunk offsets (`stco`/`co64`), the sample-to-chunk
/// runs (`stsc`) and the sizes (`stsz`).
fn sample_offsets(b: bytes, stbl: (int, int)) -> Result<([int], [int]), string> {
    let stsz = match (child(b, stbl.0, stbl.1, "stsz")) {
        Option.Some(s) => s,
        Option.None => return Result.Err("MP4: no sample sizes"),
    };
    let fixed = be32(b, stsz.0 + 4);
    let count = be32(b, stsz.0 + 8);
    if (fixed == 0 && stsz.0 + 12 + 4 * count > stsz.1) {
        return Result.Err("MP4: short sample size table");
    }
    var chunks: [int] = [];
    if let Option.Some(stco) = child(b, stbl.0, stbl.1, "stco") {
        let n = be32(b, stco.0 + 4);
        for i in 0..n {
            chunks.push(be32(b, stco.0 + 8 + 4 * i));
        }
    } else if let Option.Some(co64) = child(b, stbl.0, stbl.1, "co64") {
        let n = be32(b, co64.0 + 4);
        for i in 0..n {
            let at = co64.0 + 8 + 8 * i;
            chunks.push((be32(b, at) << 32) | be32(b, at + 4));
        }
    } else {
        return Result.Err("MP4: no chunk offsets");
    }
    let stsc = match (child(b, stbl.0, stbl.1, "stsc")) {
        Option.Some(s) => s,
        Option.None => return Result.Err("MP4: no sample-to-chunk table"),
    };
    let runs = be32(b, stsc.0 + 4);
    var offsets: [int] = [];
    var sizes: [int] = [];
    var sample = 0;
    for r in 0..runs {
        let first = be32(b, stsc.0 + 8 + 12 * r) - 1;
        let per_chunk = be32(b, stsc.0 + 12 + 12 * r);
        let last = if (r + 1 < runs) { be32(b, stsc.0 + 20 + 12 * r) - 1 } else { chunks.len() };
        for c in first..last {
            if (c >= chunks.len()) {
                return Result.Err("MP4: a chunk past the offset table");
            }
            var at = chunks[c];
            for _ in 0..per_chunk {
                if (sample >= count) {
                    return Result.Ok((offsets, sizes));
                }
                let size = if (fixed != 0) { fixed } else { be32(b, stsz.0 + 12 + 4 * sample) };
                if (at + size > b.len()) {
                    return Result.Err("MP4: a sample past the end of the file");
                }
                offsets.push(at);
                sizes.push(size);
                at = at + size;
                sample = sample + 1;
            }
        }
    }
    Result.Ok((offsets, sizes))
}
