// A Vorbis I decoder (the Xiph.Org specification), as in .ogg files from libvorbis or ffmpeg:
// mono and stereo, two block sizes, floor 1, residues 0, 1 and 2, and channel coupling. The old
// LSP floor (floor 0) is not supported. Each packet overlaps the one before it, so `seek`
// decodes the packet before the one it wants.

import mdct;
import ogg;
import std/math;

/// Bits the codebooks' first lookup table takes.
const PRIMARY: int = 10;

