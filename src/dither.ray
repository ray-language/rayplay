// From deeper samples to the player's 16 bits. Cutting the bits below the 16th leaves an error
// that follows the music (distortion in quiet passages and fades, and a bias of half a step);
// adding triangular (TPDF) noise of ±1 step before rounding turns it into a steady hiss at
// about -93 dBFS, with nothing of the music in it.
//
// The noise comes from a hash of where the sample is, not from a running generator: a sample
// gets the same noise however it was reached (from the start, after a seek, read twice).

const MASK: int = 0xFFFFFFFF;

/// 32 well-mixed bits from `x` (any int; only its low 32 bits count). The multipliers stay
/// below 2^31, so the products fit in 63 bits.
fn mix(x: int) -> int {
    var h = x & MASK;
    h = h ^ (h >> 16);
    h = (h * 0x7FEB352D) & MASK;
    h = h ^ (h >> 15);
    h = (h * 0x2C1B3C6D) & MASK;
    h ^ (h >> 16)
}

/// `v`, a signed sample of `depth` bits (4 to 32), as 16 bits: dithered and rounded if deeper,
/// scaled up if shallower. `at` says where the sample is; neighbours must differ in it.
pub fn to_16(v: int, depth: int, at: int) -> int {
    if (depth <= 16) {
        return v << (16 - depth);
    }
    let shift = depth - 16;
    let h = mix(at);
    // Two uniform values of `shift` bits each: their sum less one range is triangular.
    let u1 = (h & 0xFFFF) >> (16 - shift);
    let u2 = (h >> 16) >> (16 - shift);
    let out = (v + u1 + u2 - (1 << shift) + (1 << (shift - 1))) >> shift;
    if (out > 32767) { 32767 } else if (out < -32768) { -32768 } else { out }
}

/// Where sample `i` of channel `c` of a block found at `base` is, for `to_16`.
pub fn place(base: int, i: int, c: int) -> int {
    base * 0x9E3779B1 + i * 8 + c
}
