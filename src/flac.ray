// A FLAC decoder (https://xiph.org/flac/format.html): native FLAC streams with any block size,
// 4 to 32 bits per sample and the four channel assignments. The result is 16-bit PCM for the
// player: deeper samples are truncated to 16 bits, shallower ones scaled up, and of a stream
// with more than two channels only the first two (front left and right) are kept.
//
// It decodes a frame at a time (`next`), so a track plays while it is decoded, and `seek`
// finds the frame holding any sample by bisecting the file on the sample numbers that frame
// headers carry: no index, nothing to scan when a file is loaded.

import bits;

struct Info {
    rate: int,
    channels: int,
    depth: int,
    /// The block size of a fixed-blocksize stream (frame number × it = first sample).
    max_block: int,
    /// Samples per channel; 0 when the encoder did not know.
    total: int,
}

fn info_none() -> Info {
    Info { rate: 0, channels: 0, depth: 0, max_block: 0, total: 0 }
}

/// Block sizes by the 4-bit code of the frame header (0 = reserved, 6/7 = read after it).
fn block_size(code: int) -> int {
    if (code == 1) {
        192
    } else if (code >= 2 && code <= 5) {
        576 << (code - 2)
    } else if (code >= 8) {
        256 << (code - 8)
    } else {
        0
    }
}

fn sample_depth(code: int, stream: int) -> int {
    match (code) {
        0 => stream,
        1 => 8,
        2 => 12,
        4 => 16,
        5 => 20,
        6 => 24,
        7 => 32,
        _ => 0,
    }
}

fn sample_rate(code: int, stream: int) -> int {
    match (code) {
        0 => stream,
        1 => 88200,
        2 => 176400,
        3 => 192000,
        4 => 8000,
        5 => 16000,
        6 => 22050,
        7 => 24000,
        8 => 32000,
        9 => 44100,
        10 => 48000,
        11 => 96000,
        _ => 0,
    }
}

/// CRC-8 (polynomial 0x07) of octets `from..to`: guards the frame header against false syncs.
fn crc8(b: bytes, from: int, to: int) -> int {
    var crc = 0;
    for i in from..to {
        crc = crc ^ b[i];
        for _ in 0..8 {
            crc = if ((crc & 128) != 0) { ((crc << 1) ^ 7) & 255 } else { (crc << 1) & 255 };
        }
    }
    crc
}

/// Reads STREAMINFO from the metadata blocks after `fLaC`; returns it and where the frames start.
fn read_metadata(b: bytes, from: int) -> Result<(Info, int), string> {
    if (b.len() < from + 8 || from_utf8(b.sub_bytes(from, from + 4)).unwrap_or("") != "fLaC") {
        return Result.Err("not a FLAC file");
    }
    var at = from + 4;
    var info = info_none();
    var last = false;
    while (!last) {
        if (at + 4 > b.len()) {
            return Result.Err("FLAC: truncated metadata");
        }
        last = (b[at] & 128) != 0;
        let kind = b[at] & 127;
        let size = (b[at + 1] << 16) | (b[at + 2] << 8) | b[at + 3];
        if (kind == 0 && size >= 18) {
            let r = bits.over_range(b, at + 4, at + 4 + size);
            bits.skip(r, 16);
            let max_block = bits.get(r, 16);
            bits.skip(r, 48);
            let rate = bits.get(r, 20);
            let channels = bits.get(r, 3) + 1;
            let depth = bits.get(r, 5) + 1;
            let total = bits.get_long(r, 36);
            info = Info {
                rate: rate,
                channels: channels,
                depth: depth,
                max_block: max_block,
                total: total
            };
        }
        at = at + 4 + size;
    }
    if (info.rate == 0) {
        return Result.Err("FLAC without STREAMINFO");
    }
    Result.Ok((info, at))
}

/// Decodes the residual of a subframe into `out` (which already holds the warm-up samples).
fn residual(r: bits.Bits, out: [int], block: int, order: int) -> Result<unit, string> {
    let method = bits.get(r, 2);
    if (method > 1) {
        return Result.Err("FLAC: reserved residual coding");
    }
    let param_bits = if (method == 0) { 4 } else { 5 };
    let escape = if (method == 0) { 15 } else { 31 };
    let parts = 1 << bits.get(r, 4);
    if (block % parts != 0 || block / parts < order) {
        return Result.Err("FLAC: bad residual partition");
    }
    for p in 0..parts {
        let n = if (p == 0) { block / parts - order } else { block / parts };
        let k = bits.get(r, param_bits);
        if (k == escape) {
            let raw = bits.get(r, 5);
            for _ in 0..n {
                out.push(bits.get_signed(r, raw));
            }
        } else {
            for _ in 0..n {
                let q = bits.unary(r);
                let v = (q << k) | bits.get(r, k);
                out.push((v >> 1) ^ (0 - (v & 1)));
            }
        }
    }
    if (bits.over(r)) {
        return Result.Err("FLAC: truncated frame");
    }
    Result.Ok({ })
}

/// One subframe of `block` samples at `depth` bits.
fn subframe(r: bits.Bits, block: int, depth: int) -> Result<[int], string> {
    if (bits.get(r, 1) != 0) {
        return Result.Err("FLAC: bad subframe padding");
    }
    let kind = bits.get(r, 6);
    var wasted = 0;
    if (bits.get(r, 1) == 1) {
        wasted = bits.unary(r) + 1;
    }
    let d = depth - wasted;
    var out: [int] = [];
    if (kind == 0) {
        let v = bits.get_signed(r, d);
        for _ in 0..block {
            out.push(v);
        }
    } else if (kind == 1) {
        for _ in 0..block {
            out.push(bits.get_signed(r, d));
        }
    } else if (kind >= 8 && kind <= 12) {
        let order = kind - 8;
        for _ in 0..order {
            out.push(bits.get_signed(r, d));
        }
        residual(r, out, block, order)?;
        fixed_predict(out, order);
    } else if (kind >= 32) {
        let order = kind - 31;
        for _ in 0..order {
            out.push(bits.get_signed(r, d));
        }
        let precision = bits.get(r, 4) + 1;
        if (precision == 16) {
            return Result.Err("FLAC: bad LPC precision");
        }
        let shift = bits.get_signed(r, 5);
        if (shift < 0) {
            return Result.Err("FLAC: negative LPC shift");
        }
        var coefs: [int] = [];
        for _ in 0..order {
            coefs.push(bits.get_signed(r, precision));
        }
        residual(r, out, block, order)?;
        lpc_predict(out, coefs, shift);
    } else {
        return Result.Err("FLAC: reserved subframe type ${to_string(kind)}");
    }
    if (wasted > 0) {
        for i in 0..block {
            out[i] = out[i] << wasted;
        }
    }
    Result.Ok(out)
}

/// Turns residuals into samples with the fixed polynomial predictor of `order` (0..4).
fn fixed_predict(s: [int], order: int) -> unit {
    let n = s.len();
    if (order == 1) {
        for i in 1..n {
            s[i] = s[i] + s[i - 1];
        }
    } else if (order == 2) {
        for i in 2..n {
            s[i] = s[i] + 2 * s[i - 1] - s[i - 2];
        }
    } else if (order == 3) {
        for i in 3..n {
            s[i] = s[i] + 3 * s[i - 1] - 3 * s[i - 2] + s[i - 3];
        }
    } else if (order == 4) {
        for i in 4..n {
            s[i] = s[i] + 4 * s[i - 1] - 6 * s[i - 2] + 4 * s[i - 3] - s[i - 4];
        }
    }
}

fn lpc_predict(s: [int], coefs: [int], shift: int) -> unit {
    let order = coefs.len();
    for i in order..s.len() {
        var sum = 0;
        for j in 0..order {
            sum = sum + coefs[j] * s[i - 1 - j];
        }
        s[i] = s[i] + (sum >> shift);
    }
}

/// A frame header that checked out.
struct Head {
    at: int,
    /// The first sample of the frame (per channel, from the start of the stream).
    first: int,
    block: int,
    depth: int,
    assignment: int,
    /// The bit where the first subframe starts.
    body: int,
}

/// Parses the frame header at `at`: sync code, no reserved values, the stream's own rate and
/// channel count, well-formed frame number and a good CRC-8 (which, with the rest, tells a
/// header from the same bits inside audio data).
fn header(b: bytes, at: int, info: Info) -> Result<Head, string> {
    if (at + 6 > b.len() || b[at] != 255 || (b[at + 1] & 254) != 248) {
        return Result.Err("FLAC: no frame header");
    }
    let variable = (b[at + 1] & 1) == 1;
    let r = bits.over_range(b, at, b.len());
    bits.skip(r, 16);
    let size_code = bits.get(r, 4);
    let rate_code = bits.get(r, 4);
    let assignment = bits.get(r, 4);
    let depth = sample_depth(bits.get(r, 3), info.depth);
    bits.skip(r, 1);
    // The frame or sample number, UTF-8 style: the leading ones say how many octets follow.
    let lead = bits.get(r, 8);
    var extra = 0;
    var mask = 128;
    while ((lead & mask) != 0 && mask > 1) {
        extra = extra + 1;
        mask = mask >> 1;
    }
    if (extra == 1 || extra > 7) {
        return Result.Err("FLAC: bad frame number");
    }
    var number = lead & (mask - 1);
    for _ in 1..extra {
        let more = bits.get(r, 8);
        if ((more & 192) != 128) {
            return Result.Err("FLAC: bad frame number");
        }
        number = (number << 6) | (more & 63);
    }
    var block = block_size(size_code);
    if (size_code == 6) {
        block = bits.get(r, 8) + 1;
    } else if (size_code == 7) {
        block = bits.get(r, 16) + 1;
    }
    if (rate_code == 12) {
        bits.skip(r, 8);
    } else if (rate_code == 13 || rate_code == 14) {
        bits.skip(r, 16);
    }
    let head_end = bits.octet_pos(r);
    if (head_end >= b.len() || crc8(b, at, head_end) != b[head_end]) {
        return Result.Err("FLAC: bad frame header");
    }
    bits.skip(r, 8);
    if (block == 0 || depth == 0 || rate_code == 15 || assignment > 10) {
        return Result.Err("FLAC: reserved value in the frame header");
    }
    let channels = if (assignment <= 7) { assignment + 1 } else { 2 };
    let rate = sample_rate(rate_code, info.rate);
    if (channels != info.channels || (rate_code < 12 && rate != info.rate)) {
        return Result.Err("FLAC: frame header of another stream");
    }
    let first = if (variable) { number } else { number * info.max_block };
    Result.Ok(
        Head {
            at: at,
            first: first,
            block: block,
            depth: depth,
            assignment: assignment,
            body: r.pos
        }
    )
}

/// The first good frame header at or after `at`, before `limit`.
fn header_after(b: bytes, at: int, limit: int, info: Info) -> Option<Head> {
    let stop = if (limit < b.len()) { limit } else { b.len() };
    var i = at;
    while (i + 1 < stop) {
        if (b[i] == 255 && (b[i + 1] & 254) == 248) {
            if let Result.Ok(h) = header(b, i, info) {
                return Option.Some(h);
            }
        }
        i = i + 1;
    }
    Option.None
}

/// Decodes the frame `h` heads, appending its samples to `out`; returns where the next one starts.
fn frame(b: bytes, h: Head, info: Info, out: [int]) -> Result<int, string> {
    let r = bits.over_range(b, 0, b.len());
    r.pos = h.body;
    let block = h.block;
    let depth = h.depth;
    let assignment = h.assignment;
    let channels = if (assignment <= 7) { assignment + 1 } else { 2 };
    var chans: [[int]] = [];
    for c in 0..channels {
        // The side channel of a stereo decorrelation carries one more bit.
        let side = (assignment == 8 && c == 1)
            || (assignment == 9 && c == 0)
            || (assignment == 10 && c == 1);
        chans.push(subframe(r, block, if (side) { depth + 1 } else { depth })?);
    }
    bits.align(r);
    bits.skip(r, 16);
    let left = chans[0];
    if (assignment == 8) {
        let side = chans[1];
        for i in 0..block {
            side[i] = left[i] - side[i];
        }
    } else if (assignment == 9) {
        let right = chans[1];
        for i in 0..block {
            left[i] = left[i] + right[i];
        }
    } else if (assignment == 10) {
        let side = chans[1];
        for i in 0..block {
            let mid = (left[i] << 1) | (side[i] & 1);
            left[i] = (mid + side[i]) >> 1;
            side[i] = (mid - side[i]) >> 1;
        }
    }
    let keep = if (info.channels > 2) { 2 } else { info.channels };
    let a = chans[0];
    let c = if (keep == 2 && channels > 1) { chans[1] } else { chans[0] };
    for i in 0..block {
        if (depth >= 16) {
            out.push(a[i] >> (depth - 16));
            if (keep == 2) {
                out.push(c[i] >> (depth - 16));
            }
        } else {
            out.push(a[i] << (16 - depth));
            if (keep == 2) {
                out.push(c[i] << (16 - depth));
            }
        }
    }
    Result.Ok(bits.octet_pos(r))
}

/// A FLAC file being played.
pub struct Stream {
    b: bytes,
    info: Info,
    /// Where the first frame starts.
    start: int,
    /// Where the next frame to decode starts.
    at: int,
    rate: int,
    /// The channels it is decoded to (1 or 2).
    channels: int,
    /// Frames (samples per channel) in the file.
    total: int,
}

/// Opens the FLAC file whose `fLaC` marker is at octet `from`: reads its metadata and finds
/// the first frame. Nothing is decoded yet.
pub fn open(b: bytes, from: int) -> Result<Stream, string> {
    let (info, start) = read_metadata(b, from)?;
    if (info.channels < 1 || info.rate < 1) {
        return Result.Err("FLAC: bad STREAMINFO");
    }
    let first = match (header_after(b, start, b.len(), info)) {
        Option.Some(h) => h.at,
        Option.None => return Result.Err("FLAC without audio frames"),
    };
    let total = if (info.total > 0) { info.total } else { count_from_tail(b, first, info) };
    Result.Ok(
        Stream {
            b: b,
            info: info,
            start: first,
            at: first,
            rate: info.rate,
            channels: if (info.channels > 2) { 2 } else { info.channels },
            total: total
        }
    )
}

/// The length of a stream whose STREAMINFO does not say it: where the last frame ends.
fn count_from_tail(b: bytes, first: int, info: Info) -> int {
    let window = b.len() - 1048576;
    var at = if (window > first) { window } else { first };
    var total = 0;
    var more = true;
    while (more) {
        match (header_after(b, at, b.len(), info)) {
            Option.Some(h) => {
                total = h.first + h.block;
                at = h.at + 1;
            },
            Option.None => {
                more = false;
            },
        }
    }
    total
}

/// Decodes the next frame, appending its samples to `out`; returns the frame its first
/// sample is, or None at the end of the file. A damaged frame is skipped (decoding resumes at
/// the next good header).
pub fn next(s: Stream, out: [int]) -> Option<int> {
    while (s.at < s.b.len()) {
        match (header_after(s.b, s.at, s.b.len(), s.info)) {
            Option.Some(h) => {
                match (frame(s.b, h, s.info, out)) {
                    Result.Ok(after) => {
                        s.at = after;
                        return Option.Some(h.first);
                    },
                    Result.Err(_) => {
                        s.at = h.at + 1;
                    },
                }
            },
            Option.None => {
                s.at = s.b.len();
            },
        }
    }
    Option.None
}

/// Makes `next` continue from the frame that holds sample `pos`: bisects the file on the
/// headers' sample numbers down to 64 KB, then walks the headers in that stretch.
pub fn seek(s: Stream, pos: int) -> unit {
    var lo = s.start;
    var hi = s.b.len();
    while (hi - lo > 65536) {
        let mid = lo + (hi - lo) / 2;
        match (header_after(s.b, mid, hi, s.info)) {
            Option.Some(h) => {
                if (h.first <= pos) {
                    lo = h.at;
                } else {
                    hi = mid;
                }
            },
            Option.None => {
                hi = mid;
            },
        }
    }
    var best = lo;
    var more = true;
    while (more) {
        match (header_after(s.b, best + 1, s.b.len(), s.info)) {
            Option.Some(h) => {
                if (h.first <= pos) {
                    best = h.at;
                } else {
                    more = false;
                }
            },
            Option.None => {
                more = false;
            },
        }
    }
    s.at = best;
}
