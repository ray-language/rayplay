// RayPlay — a small audio player whose sound comes from the raylang program (std/audio), not
// from the page: the point is to exercise playback in the background on iOS and Android
// (`[ios] background_audio`, `[android] background_audio` in ray.toml). The page (www/) is
// plain HTML on ray-elements served over ray://app and talks to the player through
// `window.ray.request`; `elements/bridge` answers the components' own requests.

import std/media;
import std/time;
import std/ui;
import elements/bridge;
import api;
import player;
import remote;
import synth;

const APP_NAME: string = "RayPlay";

fn page_url() -> Result<string, string> {
    let url = ui.app_url("app://index.html");
    if (url.starts_with("ray://")) {
        // Also under `ray dev --device` since raylang 1.27.46 (findings #109).
        let files = ui.mount_embed_at("", "www")?;
        if (files == 0) {
            return Result.Err("no embedded page under www/");
        }
    }
    Result.Ok(url)
}

fn main() -> int {
    let url = match (page_url()) {
        Result.Ok(u) => u,
        Result.Err(e) => {
            eprint("rayplay: " + e);
            return 1;
        },
    };
    let cmds: Channel<player.Cmd> = Channel.bounded(64);
    let _actor = spawn(fn() {
        player.run(cmds, synth.builtin());
    });

    var o = ui.options(420, 760);
    o.min_width = 320;
    o.min_height = 480;
    o.autosave = "rayplay.main";
    let window = match (ui.open_with(APP_NAME, url, o)) {
        Result.Ok(w) => w,
        Result.Err(e) => {
            eprint("rayplay: " + e);
            return 1;
        },
    };

    // Into the system's Now Playing: the player publishes the track, the commands come here.
    if let Result.Err(e) = media.controls(remote.commands()) {
        eprint("rayplay: media controls: " + e);
    }
    var seek_ms = -1;
    var seek_at = 0;

    while (true) {
        let e = match (ui.next_event()) {
            Result.Ok(e) => e,
            Result.Err(err) => {
                eprint("rayplay: " + err);
                return 1;
            },
        };
        if (bridge.handle(e)) {
            continue; // a ray-elements request, already answered
        }
        if (e.kind == "closed" && e.window == window) {
            send(cmds, player.Cmd.Quit);
            return 0;
        }
        if (e.kind == "lifecycle") {
            // The mobile shells report background/foreground; the player keeps playing
            // and counts how much sounded meanwhile, which the page shows on return.
            let note = e.tag + " " + player.stamp();
            eprint("rayplay: lifecycle " + note);
            send(cmds, player.Cmd.Note(note));
        }
        if (e.kind == "media") {
            match (remote.command(e.tag)) {
                Option.Some(player.Cmd.Seek(ms)) => {
                    let now = time.now();
                    if (!remote.is_repeat(ms, now, seek_ms, seek_at)) {
                        send(cmds, player.Cmd.Seek(ms));
                    }
                    seek_ms = ms;
                    seek_at = now;
                },
                Option.Some(c) => send(cmds, c),
                Option.None => eprint("rayplay: unknown media command " + e.tag),
            }
        }
        if (e.kind == "message") {
            match (ui.as_request(e)) {
                Option.Some(req) => {
                    // Shells older than raylang 1.27.17 cannot be answered on window 0.
                    let target = if (e.window == 0) { window } else { e.window };
                    match (ui.reply_json(target, req.0, api.handle(cmds, req.1))) {
                        Result.Err(err) => eprint("rayplay: reply: " + err),
                        Result.Ok(_) => { },
                    }
                },
                Option.None => { },
            }
        }
    }
    0
}
