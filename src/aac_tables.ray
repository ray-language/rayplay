/// The 11 spectral codebooks, one after another.
pub fn spectral() -> [int] {
    spectral_1()
        + spectral_2()
        + spectral_3()
        + spectral_4()
        + spectral_5()
        + spectral_6()
        + spectral_7()
        + spectral_8()
        + spectral_9()
        + spectral_10()
        + spectral_11()
}

