import std/json;
import api;
import player;
import synth;

fn start_player() -> Channel<player.Cmd> {
    let cmds: Channel<player.Cmd> = Channel.bounded(64);
    let _a = spawn(fn() {
        player.run(cmds, synth.builtin());
    });
    cmds
}

@test
fn state_lists_the_playlist_as_json() {
    let cmds = start_player();
    let reply = json.parse(api.handle(cmds, "{\"op\":\"state\"}")).unwrap();
    assert_eq(json.get_int(reply, "current"), Option.Some(0));
    assert_eq(json.get_int(reply, "volume"), Option.Some(80));
    let tracks = json.member(reply, "tracks").unwrap();
    match (tracks) {
        json.Json.JArray(items) => {
            assert_eq(items.len(), 3);
            assert_eq(json.get_string(items[0], "name"), Option.Some("Pentatonic Etude"));
        },
        _ => panic("tracks is not an array"),
    }
    send(cmds, player.Cmd.Quit);
}

@test
fn bad_requests_fail_cleanly() {
    let cmds = start_player();
    let r1 = json.parse(api.handle(cmds, "{\"op\":\"nope\"}")).unwrap();
    assert_eq(json.get_string(r1, "error"), Option.Some("unknown op: nope"));
    let r2 = json.parse(api.handle(cmds, "{\"op\":\"seek\"}")).unwrap();
    assert_eq(json.get_string(r2, "error"), Option.Some("missing field 'ms'"));
    let r3 = json.parse(api.handle(cmds, "not json")).unwrap();
    assert(json.get_string(r3, "error").is_some());
    let r4 = json.parse(api.handle(cmds, "add:x\nAQID")).unwrap();
    assert_eq(json.get_string(r4, "error"), Option.Some("not a WAV, AIFF, FLAC, MP3 or ALAC file"));
    let r5 = json.parse(api.handle(cmds, "add:x")).unwrap();
    assert_eq(json.get_string(r5, "error"), Option.Some("add: missing the file after the name"));
    let r6 = json.parse(api.handle(cmds, "add:x\nab!d")).unwrap();
    assert(json.get_string(r6, "error").is_some());
    send(cmds, player.Cmd.Quit);
}

@test
fn a_loaded_wav_joins_the_playlist() {
    let cmds = start_player();
    // RIFF header of a 2-frame stereo 8 kHz file, base64.
    let file = "UklGRiwAAABXQVZFZm10IBAAAAABAAIAQB8AAAB9AAAEABAAZGF0YQgAAAABAP///38AgA==";
    let reply = json.parse(api.handle(cmds, "add:tiny\n" + file)).unwrap();
    match (json.member(reply, "tracks").unwrap()) {
        json.Json.JArray(items) => {
            assert_eq(items.len(), 4);
            assert_eq(json.get_string(items[3], "name"), Option.Some("tiny"));
        },
        _ => panic("tracks is not an array"),
    }
    send(cmds, player.Cmd.Quit);
}

@test
fn track_names_drop_the_folder_and_the_extension() {
    assert_eq(api.track_name("/var/mobile/Inbox/Field Recording.WAV"), "Field Recording");
    assert_eq(api.track_name("C:\\music\\loop.wav"), "loop");
    assert_eq(api.track_name("~/Music/01 Intro.mp3"), "01 Intro");
    assert_eq(api.track_name("Live.FLAC"), "Live");
    assert_eq(api.track_name("Take 2.aif"), "Take 2");
    assert_eq(api.track_name("Loop.AIFF"), "Loop");
    assert_eq(api.track_name("Lossless.m4a"), "Lossless");
    assert_eq(api.track_name("notes.txt"), "notes.txt");
    assert_eq(api.track_name("take"), "take");
}

@test
fn a_picked_wav_is_read_from_disk() {
    // `make test` answers the dialog with tests/fixtures/tiny.wav (RAY_UI_PICK).
    let cmds = start_player();
    let reply = json.parse(api.handle(cmds, "{\"op\":\"pick\"}")).unwrap();
    match (json.member(reply, "tracks").unwrap()) {
        json.Json.JArray(items) => {
            assert_eq(items.len(), 4);
            assert_eq(json.get_string(items[3], "name"), Option.Some("tiny"));
        },
        _ => panic("tracks is not an array"),
    }
    send(cmds, player.Cmd.Quit);
}
