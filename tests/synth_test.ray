import std/fs;
import codec;
import synth;
import wav;

@test
fn a_chunk_has_frames_times_channels_times_three_bytes() {
    let t = synth.builtin()[0];
    let c = synth.chunk(t, 0, 441, 80);
    assert_eq(c.len(), 441 * 2 * 3);
}

@test
fn past_the_end_a_chunk_is_silence() {
    let t = synth.builtin()[2];
    let c = synth.chunk(t, synth.total_frames(t), 10, 100);
    assert_eq(c.len(), 60);
    for i in 0..c.len() {
        assert_eq(c[i], 0);
    }
}

@test
fn volume_zero_is_silence_and_full_volume_is_not() {
    let t = synth.builtin()[1];
    let quiet = synth.chunk(t, 44100, 100, 0);
    var loud_energy = 0;
    let loud = synth.chunk(t, 44100, 100, 100);
    for i in 0..quiet.len() {
        assert_eq(quiet[i], 0);
        loud_energy = loud_energy + loud[i];
    }
    assert(loud_energy > 0);
}

@test
fn a_loaded_wav_plays_its_own_samples_scaled() {
    // One 16-bit stereo frame at +16384 / -16384 comes back at full volume as the same values
    // in 24 bits, and at half volume halved.
    let p = wav.Pcm { rate: 8000, channels: 2, data: bytes_of([0, 64, 0, 192]) };
    let t = synth.loaded("t", codec.open(wav.encode(p)).unwrap());
    assert_eq(t.duration_ms, 0);
    let c = synth.chunk(t, 0, 1, 100);
    assert(c == bytes_of([0, 0, 64, 0, 0, 192]));
    let half = synth.chunk(t, 0, 1, 50);
    assert(half == bytes_of([0, 0, 32, 0, 0, 224]));
}

/// The left sample of `frame` in an s24le stereo chunk.
fn left(c: bytes, frame: int) -> int {
    let at = frame * 6;
    var v = c[at] | (c[at + 1] << 8) | (c[at + 2] << 16);
    if (v >= 8388608) {
        v = v - 16777216;
    }
    v
}

@test
fn a_ramp_between_equal_volumes_is_the_plain_chunk() {
    let t = synth.builtin()[1];
    assert(synth.chunk_ramp(t, 1000, 2205, 60, 60) == synth.chunk(t, 1000, 2205, 60));
}

@test
fn a_volume_ramp_ends_at_the_new_volume() {
    // The last frame of the ramp is already at the target gain, so the next chunk (played
    // at that volume) continues it without a step.
    let t = synth.builtin()[1];
    let ramp = synth.chunk_ramp(t, 0, 2205, 20, 90);
    let target = synth.chunk(t, 0, 2205, 90);
    assert_eq(left(ramp, 2204), left(target, 2204));
    let start = synth.chunk(t, 0, 2205, 20);
    assert(left(ramp, 1100) != left(start, 1100));
}

@test
fn a_loaded_flac_is_a_streamed_track() {
    let b = fs.read_file_bytes("tests/fixtures/tiny.flac").unwrap();
    let t = synth.loaded("t", codec.open(b).unwrap());
    assert_eq(synth.total_frames(t), 13230);
    assert_eq(t.duration_ms, 300);
    // At full volume it plays the decoded samples unchanged: each 16-bit sample, low octet
    // first, behind a zero octet.
    let whole = codec.decode(b).unwrap();
    let c = synth.chunk(t, 2000, 441, 100);
    assert_eq(c.len(), 441 * 6);
    for i in 0..441 * 2 {
        assert_eq(c[3 * i], 0);
        assert_eq(c[3 * i + 1], whole.data[2000 * 4 + 2 * i]);
        assert_eq(c[3 * i + 2], whole.data[2000 * 4 + 2 * i + 1]);
    }
    // Past the end, silence.
    let tail = synth.chunk(t, 13200, 100, 100);
    assert_eq(tail.len(), 600);
    for i in 180..600 {
        assert_eq(tail[i], 0);
    }
}
