// The actor, driven through its channel. `make test` sets RAY_AUDIO_SINK=null so the audio
// output is a real-time null sink: no sound card needed, the clock still runs.

import std/time;
import codec;
import player;
import synth;
import wav;

fn start_player() -> Channel<player.Cmd> {
    let cmds: Channel<player.Cmd> = Channel.bounded(64);
    let _a = spawn(fn() {
        player.run(cmds, synth.builtin());
    });
    cmds
}

@test
fn playing_advances_the_position_and_pause_holds_it() {
    let cmds = start_player();
    let idle = player.query(cmds);
    assert_eq(idle.tracks.len(), 3);
    assert(!idle.playing);
    send(cmds, player.Cmd.Play(1));
    time.sleep(600);
    let s = player.query(cmds);
    assert_eq(s.current, 1);
    assert(s.playing);
    assert(s.position_ms > 100);
    send(cmds, player.Cmd.Toggle);
    time.sleep(50);
    let paused = player.query(cmds);
    assert(paused.paused);
    let at = paused.position_ms;
    time.sleep(300);
    assert_eq(player.query(cmds).position_ms, at);
    send(cmds, player.Cmd.Toggle);
    time.sleep(400);
    assert(player.query(cmds).position_ms > at);
    send(cmds, player.Cmd.Quit);
}

@test
fn next_and_prev_wrap_around_and_stop_rewinds() {
    let cmds = start_player();
    send(cmds, player.Cmd.Prev);
    assert_eq(player.query(cmds).current, 2);
    send(cmds, player.Cmd.Next);
    assert_eq(player.query(cmds).current, 0);
    send(cmds, player.Cmd.Play(0));
    time.sleep(400);
    send(cmds, player.Cmd.Stop);
    let s = player.query(cmds);
    assert(!s.playing);
    assert_eq(s.position_ms, 0);
    send(cmds, player.Cmd.Quit);
}

@test
fn seek_and_volume_are_clamped_and_notes_are_kept() {
    let cmds = start_player();
    send(cmds, player.Cmd.Seek(999999999));
    assert_eq(player.query(cmds).position_ms, 180000);
    send(cmds, player.Cmd.Seek(-5));
    assert_eq(player.query(cmds).position_ms, 0);
    send(cmds, player.Cmd.Volume(140));
    assert_eq(player.query(cmds).volume, 100);
    send(cmds, player.Cmd.Note("background 12:00:00"));
    send(cmds, player.Cmd.Play(2));
    time.sleep(500);
    let s = player.query(cmds);
    assert_eq(s.note, "background 12:00:00");
    assert(s.background_ms >= 100);
    send(cmds, player.Cmd.Quit);
}

/// A loaded track of `ms` milliseconds of quiet stereo at 44.1 kHz, the builtins' format.
fn short_track(name: string, ms: int) -> synth.Track {
    var data: [int] = [];
    for _ in 0..44100 * ms / 1000 * 4 {
        data.push(1);
    }
    let p = wav.Pcm { rate: 44100, channels: 2, data: bytes_of(data) };
    synth.loaded(name, codec.open(wav.encode(p)).unwrap())
}

@test
fn next_while_playing_goes_on_from_the_start_of_the_next_track() {
    let cmds = start_player();
    send(cmds, player.Cmd.Play(0));
    time.sleep(500);
    send(cmds, player.Cmd.Next);
    time.sleep(700);
    let s = player.query(cmds);
    assert_eq(s.current, 1);
    assert(s.playing);
    // On macOS the queue of the last one is discarded: the next track starts at once.
    assert(s.position_ms > 400);
    assert(s.position_ms < 750);
    send(cmds, player.Cmd.Quit);
}

@test
fn a_track_that_ends_runs_into_the_next() {
    let cmds = start_player();
    send(cmds, player.Cmd.Add(short_track("a", 300)));
    send(cmds, player.Cmd.Add(short_track("b", 3000)));
    send(cmds, player.Cmd.Play(3));
    time.sleep(1200);
    let s = player.query(cmds);
    assert_eq(s.current, 4);
    assert(s.playing);
    assert(s.position_ms > 300);
    assert(s.position_ms < 1200);
    send(cmds, player.Cmd.Quit);
}

@test
fn a_pause_holds_where_the_sound_stopped_and_resumes_there() {
    let cmds = start_player();
    send(cmds, player.Cmd.Play(0));
    time.sleep(600);
    let before = player.query(cmds).position_ms;
    send(cmds, player.Cmd.Toggle);
    let paused = player.query(cmds);
    assert(paused.paused);
    // On macOS the queue is discarded: the position is where the sound stopped, a moment later.
    assert(paused.position_ms >= before);
    assert(paused.position_ms < before + 200);
    send(cmds, player.Cmd.Toggle);
    time.sleep(500);
    let s = player.query(cmds);
    assert(!s.paused);
    assert(s.position_ms > paused.position_ms);
    send(cmds, player.Cmd.Quit);
}

@test
fn a_seek_while_playing_is_heard_at_once() {
    let cmds = start_player();
    send(cmds, player.Cmd.Play(0));
    time.sleep(500);
    send(cmds, player.Cmd.Seek(60000));
    // On macOS what was queued before the seek is discarded, so the new position plays right
    // away: it is never behind the seek (with the queue in front, it was for some 150 ms).
    time.sleep(50);
    let soon = player.query(cmds).position_ms;
    assert(soon >= 60000);
    assert(soon < 60150);
    time.sleep(250);
    let s = player.query(cmds);
    assert(s.position_ms >= 60150);
    assert(s.position_ms < 60400);
    send(cmds, player.Cmd.Quit);
}
