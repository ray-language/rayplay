import std/base64;
import b64;

fn octets(n: int) -> bytes {
    var xs: [int] = [];
    var i = 0;
    while (i < n) {
        xs.push(i * 37 % 256);
        i = i + 1;
    }
    bytes_of(xs)
}

@test
fn matches_std_base64_for_every_padding() {
    for n in [0, 1, 2, 3, 4, 5, 255, 256, 1000] {
        let data = octets(n);
        let text = base64.base64(data).to_bytes();
        assert_eq(b64.decode(text, 0).unwrap() == data, true);
    }
}

@test
fn crosses_the_flush_boundary() {
    let data = octets(786432 * 2 + 7);
    assert_eq(b64.decode(base64.base64(data).to_bytes(), 0).unwrap() == data, true);
}

@test
fn starts_at_an_offset() {
    let text = ("add:x\n" + base64.base64(octets(10))).to_bytes();
    assert_eq(b64.decode(text, 6).unwrap() == octets(10), true);
}

@test
fn rejects_malformed_input() {
    assert(b64.decode("abc".to_bytes(), 0).is_err());
    assert(b64.decode("ab!d".to_bytes(), 0).is_err());
    assert(b64.decode("a=bc".to_bytes(), 0).is_err());
    assert(b64.decode("ab=c".to_bytes(), 0).is_err());
    assert(b64.decode("ab==abcd".to_bytes(), 0).is_err());
}
