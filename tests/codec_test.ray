import std/fs;
import codec;
import wav;

fn fixture(name: string) -> bytes {
    fs.read_file_bytes("tests/fixtures/" + name).unwrap()
}

/// The largest difference between two s16le buffers of the same length, or -1 if the lengths
/// differ.
fn max_diff(a: bytes, b: bytes) -> int {
    if (a.len() != b.len()) {
        return -1;
    }
    var worst = 0;
    var i = 0;
    let n = a.len();
    while (i < n) {
        var x = a[i] + a[i + 1] * 256;
        var y = b[i] + b[i + 1] * 256;
        if (x >= 32768) {
            x = x - 65536;
        }
        if (y >= 32768) {
            y = y - 65536;
        }
        let d = if (x > y) { x - y } else { y - x };
        if (d > worst) {
            worst = d;
        }
        i = i + 2;
    }
    worst
}

// The references (*.raw) are ffmpeg's output for the same files: FLAC is lossless, so it must
// match exactly; MP3 decoders differ in the last bit or two of rounding.

@test
fn a_16_bit_stereo_flac_decodes_exactly() {
    let p = codec.decode(fixture("tiny.flac")).unwrap();
    assert_eq(p.rate, 44100);
    assert_eq(p.channels, 2);
    assert_eq(max_diff(p.data, fixture("tiny.flac.raw")), 0);
}

@test
fn a_24_bit_mono_flac_decodes_to_16_bits_with_dither() {
    let p = codec.decode(fixture("tiny24.flac")).unwrap();
    assert_eq(p.channels, 1);
    assert(within_dither(p.data, fixture("tiny24.flac.raw")));
}

@test
fn an_mp3_with_id3_tags_decodes_gapless() {
    // ID3v2 in front, a LAME Info frame (encoder delay and padding are trimmed), ID3v1 behind.
    let p = codec.decode(fixture("tiny.mp3")).unwrap();
    assert_eq(p.rate, 44100);
    assert_eq(p.channels, 2);
    let d = max_diff(p.data, fixture("tiny.mp3.raw"));
    assert(d >= 0 && d <= 2);
}

@test
fn an_mpeg2_mono_mp3_decodes() {
    let p = codec.decode(fixture("tiny22.mp3")).unwrap();
    assert_eq(p.rate, 22050);
    assert_eq(p.channels, 1);
    let d = max_diff(p.data, fixture("tiny22.mp3.raw"));
    assert(d >= 0 && d <= 2);
}

@test
fn a_wav_still_goes_through_the_wav_reader() {
    let p = codec.decode(fixture("tiny.wav")).unwrap();
    assert_eq(wav.frames(p), 2);
}

@test
fn damaged_and_unknown_files_are_refused() {
    assert(codec.decode(bytes_of([1, 2, 3])).is_err());
    assert(codec.decode("hello, world".to_bytes()).is_err());
    // A FLAC marker with nothing behind it.
    assert(codec.decode("fLaC".to_bytes()).is_err());
    // The first 300 octets of a FLAC: STREAMINFO is there, the frames are cut short.
    assert(codec.decode(fixture("tiny.flac").sub_bytes(0, 300)).is_err());
}

@test
fn a_truncated_mp3_keeps_the_frames_it_has() {
    let whole = fixture("tiny.mp3");
    let p = codec.decode(whole.sub_bytes(0, whole.len() / 2)).unwrap();
    assert(wav.frames(p) > 0);
    assert(wav.frames(p) < 13230);
}

@test
fn id3v2_tags_are_skipped() {
    // "ID3", version, flags, syncsafe size 0x0101 = 129, then the audio.
    var head: [int] = [73, 68, 51, 3, 0, 0, 0, 0, 1, 1];
    for _ in 0..129 {
        head.push(0);
    }
    assert_eq(codec.skip_id3(bytes_of(head) + "fLaC".to_bytes()), 139);
    assert_eq(codec.skip_id3("fLaC".to_bytes()), 0);
}

fn stream(name: string) -> codec.Stream {
    codec.open(fixture(name)).unwrap()
}

/// The samples of `s` from frame `from` on, as `read` serves them after `codec.decode`'s.
fn reads_like_the_whole_decode(name: string, starts: [int]) {
    let whole = codec.decode(fixture(name)).unwrap();
    let s = stream(name);
    let ch = s.channels;
    for from in starts {
        // A seek (backwards too), then a second read that goes on from it.
        let got = codec.read(s, from, 700) + codec.read(s, from + 700, 700);
        for i in 0..got.len() {
            let at = from * ch + i;
            var want = 0;
            if (2 * at + 1 < whole.data.len()) {
                want = whole.data[2 * at] + whole.data[2 * at + 1] * 256;
                if (want >= 32768) {
                    want = want - 65536;
                }
            }
            assert_eq(got[i], want);
        }
    }
}

@test
fn flac_and_mp3_open_as_streams_of_the_right_length() {
    let f = stream("tiny.flac");
    assert_eq(f.total, 13230);
    assert_eq(f.rate, 44100);
    let m = stream("tiny.mp3");
    assert_eq(m.total, 13230);
    assert_eq(stream("tiny.wav").total, 2);
    assert_eq(stream("tiny.aiff").total, 13230);
}

@test
fn a_flac_read_after_any_seek_is_exact() {
    reads_like_the_whole_decode("tiny.flac", [9000, 0, 4095, 4096, 12900, 2000]);
    reads_like_the_whole_decode("tiny24.flac", [6000, 100, 13000]);
}

@test
fn an_mp3_read_after_any_seek_matches_decoding_from_the_start() {
    // The seek decodes the frames before the target first, so even the bit reservoir and the
    // overlap match a decode from the start.
    reads_like_the_whole_decode("tiny.mp3", [9000, 0, 1152, 5000, 12900]);
    reads_like_the_whole_decode("tiny22.mp3", [4000, 0, 7000]);
}

@test
fn aiff_and_aiff_c_read_exactly() {
    // 16-bit stereo big-endian, and AIFF-C `sowt` (little-endian): the samples of tiny.flac.
    let p = codec.decode(fixture("tiny.aiff")).unwrap();
    assert_eq(p.rate, 44100);
    assert_eq(p.channels, 2);
    assert_eq(max_diff(p.data, fixture("tiny.flac.raw")), 0);
    assert_eq(
        max_diff(codec.decode(fixture("tiny-sowt.aifc")).unwrap().data, fixture("tiny.flac.raw")),
        0
    );
    // 24-bit mono, dithered to 16 bits like a 24-bit FLAC (the reference truncates).
    let deep = codec.decode(fixture("tiny24.aiff")).unwrap();
    assert_eq(deep.channels, 1);
    assert(within_dither(deep.data, fixture("tiny24.flac.raw")));
    // 8- and 32-bit (references from ffmpeg).
    assert_eq(
        max_diff(codec.decode(fixture("tiny8.aiff")).unwrap().data, fixture("tiny8.aiff.raw")),
        0
    );
    assert(
        within_dither(
            codec.decode(fixture("tiny32.aiff")).unwrap().data,
            fixture("tiny32.aiff.raw")
        )
    );
    // Played from the file as it is: any window read on its own is the same.
    reads_like_the_whole_decode("tiny.aiff", [9000, 0, 13000]);
    reads_like_the_whole_decode("tiny24.aiff", [100, 12000]);
    reads_like_the_whole_decode("tiny8.aiff", [0, 300]);
}

@test
fn damaged_and_compressed_aiffs_are_refused() {
    let whole = fixture("tiny.aiff");
    // FORM + AIFF and nothing else, and the header without its SSND chunk.
    assert(codec.decode(whole.sub_bytes(0, 12)).is_err());
    assert(codec.decode(whole.sub_bytes(0, 38)).is_err());
    // An AIFF-C whose compression type is not PCM (`sowt` turned into `ulaw`).
    let c = fixture("tiny-sowt.aifc");
    let ulaw = c.sub_bytes(0, 50) + "ulaw".to_bytes() + c.sub_bytes(54, c.len());
    let e = codec.decode(ulaw);
    assert(e.is_err());
}

@test
fn alac_in_m4a_decodes_exactly() {
    // Made by Apple's afconvert: 16-bit stereo, 24-bit mono (dithered to 16 bits), and white
    // noise, which the encoder can only store with escapes.
    let p = codec.decode(fixture("tiny.m4a")).unwrap();
    assert_eq(p.rate, 44100);
    assert_eq(p.channels, 2);
    assert_eq(max_diff(p.data, fixture("tiny.flac.raw")), 0);
    let deep = codec.decode(fixture("tiny24.m4a")).unwrap();
    assert_eq(deep.channels, 1);
    assert(within_dither(deep.data, fixture("tiny24.flac.raw")));
    let noise = codec.decode(fixture("tiny-noise.m4a")).unwrap();
    assert_eq(max_diff(noise.data, fixture("tiny-noise.m4a.raw")), 0);
    // Packets are independent: a read after any seek is exact.
    assert_eq(stream("tiny.m4a").total, 13230);
    reads_like_the_whole_decode("tiny.m4a", [9000, 0, 4095, 4096, 12900]);
    reads_like_the_whole_decode("tiny24.m4a", [5000, 10]);
}

/// True when deep samples dithered to 16 bits (`a`) match a reference that truncates them
/// (`b`): rounding adds up to one step, and the noise one more either way.
fn within_dither(a: bytes, b: bytes) -> bool {
    let d = max_diff(a, b);
    d >= 0 && d <= 2
}

/// True when two s16le buffers have the same length and differ by at most one anywhere.
fn within_one(a: bytes, b: bytes) -> bool {
    let d = max_diff(a, b);
    d >= 0 && d <= 1
}

@test
fn aac_in_m4a_decodes_like_the_reference_decoders() {
    // afconvert's AAC-LC against Apple's own decoder, gapless (the iTunSMPB tag says how much
    // priming to drop and how long the song is); ffmpeg's at 40 kb/s, with PNS, intensity and
    // M/S stereo, TNS and short windows, against ffmpeg's float output (the noise generator is
    // the same). Both rounded to 16 bits: off by one at most.
    let p = codec.decode(fixture("tiny-aac.m4a")).unwrap();
    assert_eq(p.rate, 44100);
    assert_eq(p.channels, 2);
    assert(within_one(p.data, fixture("tiny-aac.m4a.raw")));
    let ff = codec.decode(fixture("tiny-aac-ff.m4a")).unwrap();
    assert(within_one(ff.data, fixture("tiny-aac-ff.m4a.raw")));
    // A seek decodes the packet before the one it wants, whose second half that one overlaps.
    assert_eq(stream("tiny-aac.m4a").total, 13230);
    reads_like_the_whole_decode("tiny-aac.m4a", [9000, 0, 1023, 1024, 12900]);
}

@test
fn he_aac_plays_its_aac_lc_core() {
    // HE-AAC (SBR) from afconvert: the core is AAC-LC at half the rate.
    let p = codec.decode(fixture("tiny-he.m4a")).unwrap();
    assert_eq(p.rate, 22050);
    assert_eq(p.channels, 2);
    assert_eq(p.data.len(), 6615 * 4);
}

@test
fn damaged_m4as_are_refused() {
    // The ftyp box and nothing else.
    let m4a = fixture("tiny.m4a");
    assert(codec.decode(m4a.sub_bytes(0, 40)).is_err());
    // An AAC whose configuration says AAC Main (object type 1): the first octet of the
    // AudioSpecificConfig, 0x12 for LC, turned into 0x0A.
    let aac = fixture("tiny-aac.m4a");
    let at = aac.index_of(bytes_of([0x05, 0x80, 0x80, 0x80, 0x02, 0x12])).unwrap() + 5;
    let main = aac.sub_bytes(0, at) + bytes_of([0x0A]) + aac.sub_bytes(at + 1, aac.len());
    match (codec.decode(main)) {
        Result.Err(e) => assert_eq(e, "AAC object type 1 is not supported (only LC)"),
        Result.Ok(_) => panic("AAC Main decoded"),
    }
}

@test
fn ogg_vorbis_decodes_like_libvorbis() {
    // libvorbis's encoder at quality 0.4 (stereo, coupled, short and long blocks) and at 8 kHz
    // mono, against libvorbis's own decoder; both rounded to 16 bits: off by one at most.
    let p = codec.decode(fixture("tiny.ogg")).unwrap();
    assert_eq(p.rate, 44100);
    assert_eq(p.channels, 2);
    assert(within_one(p.data, fixture("tiny.ogg.raw")));
    // All of its audio is on one page, the last: its granule position cuts the end, not the start.
    let mono = codec.decode(fixture("tiny8k.ogg")).unwrap();
    assert_eq(mono.rate, 8000);
    assert_eq(mono.channels, 1);
    assert(within_one(mono.data, fixture("tiny8k.ogg.raw")));
    // A seek decodes the packet before the one it wants, whose second half that one overlaps.
    assert_eq(stream("tiny.ogg").total, 17640);
    reads_like_the_whole_decode("tiny.ogg", [9000, 0, 127, 128, 17000]);
    reads_like_the_whole_decode("tiny8k.ogg", [2500, 1]);
}

@test
fn damaged_oggs_are_refused() {
    let ogg = fixture("tiny.ogg");
    // The identification header's page and nothing else.
    assert(codec.decode(ogg.sub_bytes(0, 58)).is_err());
    // Cut in half: the packets that are there still play.
    let half = codec.decode(ogg.sub_bytes(0, ogg.len() / 2)).unwrap();
    assert(wav.frames(half) > 0);
    assert(wav.frames(half) < 17640);
    // "OpusHead" where Vorbis has "\x01vorbis" sends it to the Opus decoder, which finds no
    // channels in what follows.
    let opus = ogg.sub_bytes(0, 28) + "OpusHead".to_bytes() + ogg.sub_bytes(36, ogg.len());
    match (codec.decode(opus)) {
        Result.Err(e) => assert_eq(e, "Opus with 0 channels (only mono and stereo)"),
        Result.Ok(_) => panic("a broken Opus header decoded"),
    }
}

@test
fn ogg_opus_decodes_like_libopus() {
    // libopus's encoder (through ffmpeg): CELT stereo at 64 kb/s, SILK mono at 12 kb/s, hybrid
    // stereo at 32 kb/s, and a mono clip that switches between hybrid and CELT (with the
    // redundant CELT frames that smooth each switch); against libopus's own floating-point
    // decoder, rounded to 16 bits. SILK is fixed-point: bit-exact.
    let p = codec.decode(fixture("tiny.opus")).unwrap();
    assert_eq(p.rate, 48000);
    assert_eq(p.channels, 2);
    assert(within_one(p.data, fixture("tiny.opus.raw")));
    let silk = codec.decode(fixture("tiny-silk.opus")).unwrap();
    assert_eq(silk.channels, 1);
    assert_eq(max_diff(silk.data, fixture("tiny-silk.opus.raw")), 0);
    let hybrid = codec.decode(fixture("tiny-hybrid.opus")).unwrap();
    assert_eq(hybrid.channels, 2);
    assert(within_one(hybrid.data, fixture("tiny-hybrid.opus.raw")));
    assert(
        within_one(
            codec.decode(fixture("tiny-switch.opus")).unwrap().data,
            fixture("tiny-switch.opus.raw")
        )
    );
    // The pre-skip is dropped and the last page's granule position cuts the end.
    assert_eq(stream("tiny.opus").total, 19200);
    assert_eq(stream("tiny-switch.opus").total, 57600);
    // A seek resets the decoder and decodes the packets before the target again.
    reads_like_the_whole_decode("tiny.opus", [9000, 0, 959, 960, 18500]);
    reads_like_the_whole_decode("tiny-silk.opus", [20000, 5]);
    reads_like_the_whole_decode("tiny-switch.opus", [40000, 100, 30000]);
}

@test
fn damaged_and_unsupported_opus_files_are_refused() {
    let opus = fixture("tiny.opus");
    // The identification header's page (27 + 1 + 19 octets) and nothing else.
    match (codec.decode(opus.sub_bytes(0, 47))) {
        Result.Err(e) => assert_eq(e, "Opus without its headers"),
        Result.Ok(_) => panic("a header decoded"),
    }
    // Cut in half: the packets that are there still play.
    let half = codec.decode(opus.sub_bytes(0, opus.len() / 2)).unwrap();
    assert(wav.frames(half) > 0);
    assert(wav.frames(half) < 19200);
    // Damaged packets become silence; the track keeps its length.
    var bad = opus;
    var at = 400;
    while (at < bad.len()) {
        bad = bad.sub_bytes(0, at) + bytes_of([bad[at] ^ 0x5A]) + bad.sub_bytes(at + 1, bad.len());
        at = at + 97;
    }
    assert_eq(wav.frames(codec.decode(bad).unwrap()), 19200);
    // 5.1 (a channel mapping of four streams) is refused.
    match (codec.decode(fixture("six.opus"))) {
        Result.Err(e) => assert_eq(e, "Opus with 6 channels (only mono and stereo)"),
        Result.Ok(_) => panic("5.1 decoded"),
    }
}
